const VoiceStateEnum = {
  READY: "ready",
  LISTENING: "listening",
  PROCESSING: "processing",
  TRANSLATING: "translating",
  SPEAKING: "speaking",
  INTERRUPTED: "interrupted",
  ERROR: "error"
};

const voiceState = {
  sessionActive: false,
  state: VoiceStateEnum.READY,
  recognition: null,
  isRecognitionRunning: false,
  isProcessing: false,
  isSpeaking: false,
  activeAudio: null,
  restartTimeout: null,
  interruptedTimeout: null,
  restartAttempts: 0,
  maxConsecutiveRestarts: 10,
  history: []
};
