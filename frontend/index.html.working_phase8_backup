function setVoiceState(newState, detailMsg) {
  voiceState.state = newState;
  
  const orb = $("#micBtn");
  const orbIcon = $("#voiceOrbIcon");
  const statusEl = $("#micStatus");
  const subStatusEl = $("#micSubStatus");
  const sessionBtn = $("#voiceSessionBtn");
  const cancelBtn = $("#bargeInCancelBtn");
  const isRev = state.translationDirection === "unr-hi";

  if (orb) {
    orb.className = "voice-orb " + newState;
  }
  if (cancelBtn) {
    cancelBtn.style.display = (newState === VoiceStateEnum.SPEAKING) ? "inline-block" : "none";
  }

  if (sessionBtn) {
    switch (newState) {
      case VoiceStateEnum.LISTENING:
      case VoiceStateEnum.PROCESSING:
      case VoiceStateEnum.INTERRUPTED:
        sessionBtn.innerHTML = "Listening… Tap to Stop";
        sessionBtn.style.background = "#dc2626";
        sessionBtn.style.boxShadow = "0 6px 20px rgba(220,38,38,0.4)";
