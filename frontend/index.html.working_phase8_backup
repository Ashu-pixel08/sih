    ? state.educationalVocab 
    : DB.numbers.map(n => ({
        id: "NUM_" + n.number,
        english: "Number " + n.number,
        hindi: n.hindi_text,
        mundari: n.mundari_text,
        category: "Numeracy",
        image_url: "",
        is_verified: true,
        validation_badge: "VERIFIED EDUCATIONAL",
        status_description: "Canonical FLN Numeracy Module"
      }));

  let filtered = allCards;
  if (state.flashcardCategory && state.flashcardCategory !== "all") {
    filtered = filtered.filter(x => x.category.toLowerCase() === state.flashcardCategory.toLowerCase());
  }
  if (state.flashcardVerifiedOnly) {
    filtered = filtered.filter(x => x.is_verified);
