function runDemoTranslate() {
  const inputEl = $("#demoHindiInput");
  const val = inputEl ? inputEl.value.trim() : "";
  if (!val) {
    state.currentDemoTranslation = null;
    renderPage();
    return;
  }

  // 1. Immediate local fallback from database
  const localRes = backendTranslate(val, "hi-unr");
  applyDemoTranslationLocal(val, localRes);

  // 2. Query live server bridge /api/translate
  if (typeof window !== "undefined" && typeof window.fetch === "function") {
    fetch("/api/translate?text=" + encodeURIComponent(val) + "&dir=hi-unr")
      .then(r => {
        if (r.ok) return r.json();
        throw new Error("Bridge server returned " + r.status);
      })
      .then(apiRes => {
        if (apiRes) applyDemoApiResult(val, apiRes);
      })
      .catch(err => {
        console.warn("Server bridge offline, local fallback active:", err);
      });
  }
}

function applyDemoApiResult(val, apiRes) {
  let source = "Safe Fallback";
