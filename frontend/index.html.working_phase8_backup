// PHASE 4: STUDENT -> IMAGE-BASED PRACTICE ENGINE (7 MODES)
// =========================================================================

function generateEducationalPracticeQuestions(mode = "mode_a", category = "all", verifiedOnly = true, count = 5) {
  loadEducationalVocabulary();
  let pool = (state.educationalVocab && state.educationalVocab.length > 0)
    ? state.educationalVocab
    : [];

  if (pool.length === 0) {
    return generateQuizQuestions();
  }

  if (category && category !== "all") {
    const catFiltered = pool.filter(x => x.category.toLowerCase() === category.toLowerCase());
    if (catFiltered.length >= 4) pool = catFiltered;
  }
  if (verifiedOnly) {
    const verFiltered = pool.filter(x => x.is_verified);
    if (verFiltered.length >= 4) pool = verFiltered;
  }

  const shuffleArray = (arr) => [...arr].sort(() => Math.random() - 0.5);
  const shuffledPool = shuffleArray(pool);
  const selectedTargets = shuffledPool.slice(0, Math.min(count, shuffledPool.length));

  const questions = [];

  selectedTargets.forEach((target, qIdx) => {
    let effectiveMode = mode;
    if (mode === "mode_g") {
      const modesList = ["mode_a", "mode_b", "mode_c", "mode_d", "mode_e", "mode_f"];
      effectiveMode = modesList[qIdx % modesList.length];
    }

    const otherItems = pool.filter(x => x.id !== target.id);
    const distractors = shuffleArray(otherItems).slice(0, 3);

    if (effectiveMode === "mode_a") {
      const options = shuffleArray([
        { text: target.hindi, correct: true },
        ...distractors.map(d => ({ text: d.hindi, correct: false }))
      ]);
      questions.push({
        mode: "mode_a",
        type: "single_choice",
        image: target.image_url,
        prompt: "चित्र देखकर सही हिंदी शब्द चुनें:",
        promptEnglish: "Look at the image and choose the matching Hindi word:",
        target: target,
        options: options,
        explanation: `${target.english} को हिंदी में '${target.hindi}' कहते हैं।`
      });
    } else if (effectiveMode === "mode_b") {
      const options = shuffleArray([
        { text: target.mundari, correct: true },
        ...distractors.map(d => ({ text: d.mundari, correct: false }))
      ]);
      questions.push({
        mode: "mode_b",
        type: "single_choice",
        image: target.image_url,
        prompt: "चित्र देखकर सही मुंडारी शब्द चुनें:",
        promptEnglish: "Look at the image and choose the matching Mundari word:",
        target: target,
        options: options,
        explanation: `${target.english} (${target.hindi}) को मुंडारी में '${target.mundari}' कहते हैं।`
      });
    } else if (effectiveMode === "mode_c") {
      const options = shuffleArray([
        { text: target.mundari, correct: true },
        ...distractors.map(d => ({ text: d.mundari, correct: false }))
      ]);
      questions.push({
        mode: "mode_c",
        type: "single_choice",
        wordPrompt: target.hindi,
        englishNote: target.english,
        prompt: `हिंदी शब्द '${target.hindi}' का सही मुंडारी अनुवाद क्या है?`,
        promptEnglish: `What is the Mundari translation of '${target.hindi}' (${target.english})?`,
        target: target,
        options: options,
        explanation: `'${target.hindi}' का मुंडारी शब्द '${target.mundari}' है।`
      });
    } else if (effectiveMode === "mode_d") {
      const options = shuffleArray([
        { text: target.hindi, correct: true },
        ...distractors.map(d => ({ text: d.hindi, correct: false }))
      ]);
      questions.push({
        mode: "mode_d",
        type: "single_choice",
        wordPrompt: target.mundari,
        englishNote: target.english,
        prompt: `मुंडारी शब्द '${target.mundari}' का सही हिंदी अर्थ क्या है?`,
        promptEnglish: `What is the Hindi meaning of Mundari word '${target.mundari}'?`,
        target: target,
        options: options,
        explanation: `मुंडारी '${target.mundari}' का हिंदी अर्थ '${target.hindi}' (${target.english}) है।`
      });
    } else if (effectiveMode === "mode_e") {
      const imageOptions = shuffleArray([
        { image: target.image_url, label: target.hindi, correct: true },
        ...distractors.map(d => ({ image: d.image_url, label: d.hindi, correct: false }))
      ]);
      questions.push({
        mode: "mode_e",
        type: "image_choice",
        wordPrompt: `${target.hindi} • ${target.mundari}`,
        englishNote: target.english,
        prompt: `दिए गए शब्द के सही चित्र पर क्लिक करें:`,
        promptEnglish: `Click on the matching picture for '${target.hindi} / ${target.mundari}' (${target.english}):`,
        target: target,
        options: imageOptions,
        explanation: `'${target.hindi}' (${target.english}) का सही चित्र यह है।`
      });
    } else if (effectiveMode === "mode_f") {
      const fourPairs = shuffleArray([target, ...distractors]);
      const leftCol = fourPairs.map(x => ({ id: x.id, text: x.hindi, english: x.english }));
      const rightCol = shuffleArray(fourPairs).map(x => ({ id: x.id, text: x.mundari, image: x.image_url }));
      questions.push({
        mode: "mode_f",
        type: "interactive_match",
        prompt: "जोड़ी बनाओ: हिंदी शब्द को सही मुंडारी शब्द से मिलाओ",
        promptEnglish: "Match pairs: Select a Hindi word on the left, then click its Mundari pair on the right.",
        left: leftCol,
        right: rightCol,
        pairsCount: fourPairs.length,
        matchedIds: [],
        selectedLeft: null,
        selectedRight: null,
        explanation: "शानदार! सभी जोड़ियाँ सही-सही मिल गईं।"
      });
    }
  });

  return questions;
}

