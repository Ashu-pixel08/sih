.quiz-progress-track {
  width: 100%;
  height: 10px;
  background: #e2e8f0;
  border-radius: 999px;
  overflow: hidden;
  margin: 10px 0 18px;
}
.quiz-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #10b981 0%, #059669 100%);
  border-radius: 999px;
  transition: width 0.35s ease;
}
.quiz-question-card {
  background: #ffffff;
  border-radius: 26px;
  border: 2px solid #dce5df;
  padding: 26px;
  box-shadow: 0 8px 30px rgba(15, 61, 42, 0.06);
}
.quiz-options-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin-top: 20px;
}
