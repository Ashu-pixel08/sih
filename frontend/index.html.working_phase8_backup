        <h3>📂 ${esc(cat)} (${pList.length} Attested Phrases)</h3>
        <table class="table mt">
          <tr><th>Hindi Phrase</th><th>Mundari Text</th><th>Phonetic Guide</th><th>Context</th><th>Audio</th></tr>
          ${pList.map(p => `
            <tr>
              <td><b>${esc(p.hindi_text)}</b></td>
              <td style="color:var(--green);font-weight:700">${esc(p.mundari_text)}</td>
              <td><i>/${esc(p.mundari_phonetic)}/</i></td>
              <td><span class="small">${esc(p.context || cat)}</span></td>
              <td>
                <button class="btn secondary" style="padding:4px 8px;font-size:11px" onclick="speakMundari('${esc(p.mundari_text)}', '${esc(p.audio_file || '')}')">
                  🔊 Play
                </button>
              </td>
            </tr>
          `).join("")}
        </table>
      </div>`;
    }
    return html;
  }

  if (active === "literacy") {
    return `<div class="card">
      <h3>📖 Foundational Literacy & Phonics Module</h3>
      <p><b>Target Scope:</b> Mother-tongue phonemic awareness, Akshara letter-sound correspondence, and initial consonant-vowel blends in Mundari.</p>
      <div class="notice warn mt">
        <b>Curriculum Status:</b> Planned extension under NIPUN Bharat MTB-MLE guidelines. Official JCERT foundational grade 1 literacy primers are currently being mapped.
      </div>
      <div class="grid g3 mt">
        <div class="card"><div class="stat">34</div><p>Core Akshara (Syllables)</p></div>
        <div class="card"><div class="stat">5</div><p>Vowel Phonemes (/a/, /i/, /u/, /e/, /o/)</p></div>
        <div class="card"><div class="stat">⏳</div><p>Status: PENDING OFFICIAL PRIMER</p></div>
      </div>
      <button class="btn outline mt" onclick="setModule('numeracy')">← Return to Numeracy Module</button>
    </div>`;
  }

  if (active === "vocab") {
    loadEducationalVocabulary();
    const cats = state.educationalCategories || [];
    const vocab = state.educationalVocab || [];
    const selectedCat = state.activeVocabCategory || (cats.length > 0 ? cats[0].name : "Animals");
    const itemsInCat = vocab.filter(x => x.category.toLowerCase() === selectedCat.toLowerCase());

    return `<div class="card">
      <div class="row between" style="flex-wrap:wrap;gap:10px">
        <div>
          <h3>🌱 Primary Educational Vocabulary (16 Domains)</h3>
          <p class="sub" style="margin:4px 0 12px">159 team-curated educational vocabulary items across 16 foundational curriculum domains.</p>
        </div>
        <div class="row" style="gap:8px">
          <button class="btn secondary" onclick="go('flashcards')">🎴 Open Flashcards</button>
          <button class="btn primary" onclick="go('practice')">✍️ Start Practice</button>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="category-pill-bar mt mb">
        ${cats.map(c => `
          <button class="category-pill ${selectedCat.toLowerCase() === c.name.toLowerCase() ? 'active' : ''}"
                  onclick="state.activeVocabCategory='${esc(c.name)}';render();">
            ${esc(c.name)} (${c.total || c.count})
          </button>
        `).join("")}
      </div>

      <div class="grid g4 mt">
        ${itemsInCat.map(it => `
          <div class="card" style="padding:14px;text-align:center;border:1px solid var(--line);background:var(--soft-bg)">
            <div style="height:90px;display:flex;align-items:center;justify-content:center;margin-bottom:8px;background:#fff;border-radius:8px;border:1px solid var(--line)">
              ${it.image_url ? `
                <img src="${it.image_url}" alt="${esc(it.english)}" style="max-height:80px;max-width:90%;object-fit:contain"
                     onerror="this.style.display='none'"/>
              ` : '<span style="font-size:32px">🖼️</span>'}
            </div>
            <div style="font-size:12px;color:var(--muted);font-weight:600">${esc(it.english)}</div>
            <div style="font-size:16px;font-weight:700;color:var(--ink);margin:4px 0">${esc(it.hindi)}</div>
            <div style="font-size:15px;font-weight:800;color:var(--green)">${esc(it.mundari)}</div>
            <span class="badge ${it.is_verified ? 'verified' : 'warn'} mt" style="font-size:10px;padding:3px 6px">
              ${it.is_verified ? '✓ Verified' : '⚠️ Under Review'}
            </span>
          </div>
        `).join("")}
      </div>
      <button class="btn outline mt" onclick="setModule('numeracy')">← Return to Numeracy Module</button>
    </div>`;
  }
}

function numberDetail(n) {
  const it = DB.numbers.find(x => x.number === n);
  if (!it) return toast("Numeral " + n + " not found in canonical FLN registry.");
  const prevNum = n > 1 ? n - 1 : 20;
  const nextNum = n < 20 ? n + 1 : 1;

  $("#content").innerHTML = `<div class="eyebrow">Number Practice (Demonstration Module)</div>
  <div class="row between">
    <h1 class="title">Number ${it.number} (${it.hindi_numeral})</h1>
    <div class="row">
      <button class="btn secondary" onclick="numberDetail(${prevNum})">← Previous (${prevNum})</button>
      <button class="btn secondary" onclick="numberDetail(${nextNum})">Next (${nextNum}) →</button>
      <button class="btn outline" onclick="go('modules')">← Back to Modules</button>
    </div>
  </div>
  <div class="grid g2 mt">
    <div class="card flash">
      <div>
        <div class="number">${it.number} (${it.hindi_numeral})</div>
        ${renderTenFrame(it.number <= 10 ? it.number : 10)}
        <h2>${it.hindi_text} ➔ <span style="color:var(--green)">${it.mundari_text}</span></h2>
        <p>Phonetic Pronunciation: <b>/${it.mundari_phonetic}/</b></p>
        <div class="row mt" style="justify-content:center">
          <button class="btn primary" onclick="speakMundari('${it.mundari_text}', '${it.audio_file}')">🔊 Play Prototype Audio (${it.mundari_phonetic})</button>
        </div>
        <span class="small badge prototype mt">SYNTHETIC_PROTOTYPE (PENDING HUMAN VALIDATION)</span>
      </div>
    </div>
    <div class="card">
      <h3>Pedagogical Competency (FLN Grade 1)</h3>
      <p><b>Learning Outcome:</b> ${esc(it.learning_outcome)}</p>
      <p><b>Linguistic Root:</b> <code>${esc(it.mundari_root)}</code></p>
      <p><b>NIPUN Code:</b> <code>${esc(it.nipun_competency_code)}</code></p>
      <p><b>Text Status:</b> <span class="badge verified">${it.text_status}</span></p>
      <p><b>Audio Status:</b> <span class="badge prototype">${it.audio_status}</span></p>
      <p><b>Audio Asset Reference:</b> <code>${it.audio_asset}</code></p>
      <p><b>Flashcard SVG Asset:</b> <code>${it.flashcard_asset}</code></p>
      <div class="notice success mt">Text is attested in reference lexicography. Authentic native-speaker recordings await field collection in Jharkhand.</div>
    </div>
  </div>`;
}

