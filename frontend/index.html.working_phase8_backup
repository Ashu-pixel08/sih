        return "Listening… Tap to Stop";
      case VoiceStateEnum.TRANSLATING:
        return "Translating…";
      case VoiceStateEnum.SPEAKING:
        return "Speaking… Tap to Interrupt";
      default:
        return "Stop Voice Session";
