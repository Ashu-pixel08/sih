// CANONICAL BACKEND TRANSLATION & LOOKUP ADAPTER
function backendTranslate(text, dir) {
  const direction = dir || (window.state && window.state.translationDirection) || "hi-unr";

  if (!text || !text.trim()) {
    return {
      source: "",
      mundari: "",
      phonetic: "",
      root: "",
      numeral: null,
      audio_file: null,
      status: "EMPTY_INPUT",
      badge: "● AWAITING INPUT",
      badgeClass: "placeholder",
      provenance: direction === "unr-hi" ? "Type or enter Mundari text to translate to Hindi" : "Type or speak Hindi text to translate",
      isBroadcastable: false,
      direction: direction
    };
  }

  const clean = text.trim();

  // Check if Hinglish mode or Latin Hinglish input
  const isLatinHinglish = /^[a-zA-Z0-9\s.,!?'"#-]+$/.test(clean) && !/[^\x00-\x7F]/.test(clean);
  const isHinglishMode = (state.inputMode === "hinglish") || (direction === "hi-unr" && isLatinHinglish && !/^\d+$/.test(clean));

  if (isHinglishMode && direction === "hi-unr") {
    const normRes = normalizeHinglish(clean);
    if (normRes.status === "UNRESOLVED") {
      return {
        source: clean,
        mundari: "This sentence could not be translated yet.",
        targetText: "This sentence could not be translated yet.",
        status: "OUT_OF_VOCABULARY",
        badge: "● OUT_OF_VOCABULARY (UNVERIFIED)",
        badgeClass: "danger",
        provenance: "Unsupported Input — Unattested Hinglish tokens: " + clean,
        isBroadcastable: false,
        direction: direction,
        normalizedHindi: clean,
        fallbackHint: "This phrase is not available in the verified classroom vocabulary."
      };
    }
    const hiResult = backendTranslate(normRes.normalizedHindi, "hi-unr");
    return {
      ...hiResult,
      source: clean,
      normalizedHindi: normRes.normalizedHindi,
      provenance: "Hinglish Normalized: \"" + clean + "\" ➔ \"" + normRes.normalizedHindi + "\" (" + (hiResult.provenance || "FLN Registry") + ")"
    };
  }

  const normalized = normalizeHindi(clean);
  const lookupClean = normalizeForLookup(clean);

  // -------------------------------------------------------------
  // REVERSE TRANSLATION: MUNDARI ➔ HINDI
  // -------------------------------------------------------------
  if (direction === "unr-hi") {
    // 1. Exact lookup in canonical numbers 1-20
    for (let item of DB.numbers) {
      const normMun = normalizeHindi(item.mundari_text);
      const lookupMun = normalizeForLookup(item.mundari_text);
      const normRoot = item.mundari_root ? normalizeHindi(item.mundari_root) : "";
      const isMunExact = clean === item.mundari_text || normalized === normMun || lookupClean === lookupMun;
      const isRootExact = normRoot && (normalized === normRoot || lookupClean === normalizeForLookup(item.mundari_root));
      const isNumExact = item.mundari_numeral && clean === String(item.mundari_numeral);
      const isVariant = Array.isArray(item.variants_attested) && item.variants_attested.some(v => clean === v || normalized === normalizeHindi(v) || lookupClean === normalizeForLookup(v));
      const isOrthVar = (normalized.endsWith("िया") && normMun === normalized.slice(0, -3) + "िआ") ||
                        (normalized.endsWith("िआ") && normMun === normalized.slice(0, -3) + "िया");

      if (isMunExact || isRootExact || isNumExact || isVariant || isOrthVar) {
        return {
          source: clean,
          mundari: item.hindi_text,
          hindi: item.hindi_text,
          targetText: item.hindi_text,
          phonetic: item.mundari_phonetic,
          root: item.mundari_root,
          numeral: item.number,
          audio_file: item.audio_file || null,
          status: "VERIFIED_EDUCATIONAL_LOOKUP",
          badge: "● VERIFIED_EDUCATIONAL_LOOKUP (MUNDARI ➔ HINDI)",
          badgeClass: "verified",
          provenance: "Canonical FLN Registry (Mundari Numeral Attested: " + item.mundari_text + " ➔ " + item.hindi_text + ")",
          isBroadcastable: true,
          direction: direction
        };
      }
    }

    // 2. Exact match against classroom phrasebook (including expanded items)
    const allPhrases = DB.phrasebook.concat(DB.expandedPhrasebook || []);
    for (let p of allPhrases) {
      const normMun = normalizeHindi(p.mundari_text);
      const lookupMun = normalizeForLookup(p.mundari_text);
      const normRoot = p.mundari_root ? normalizeHindi(p.mundari_root) : "";
      const isMunExact = clean === p.mundari_text || normalized === normMun || lookupClean === lookupMun;
      const isRootExact = normRoot && (normalized === normRoot || lookupClean === normalizeForLookup(p.mundari_root));

      if (isMunExact || isRootExact) {
        return {
          source: clean,
          mundari: p.hindi_text,
          hindi: p.hindi_text,
          targetText: p.hindi_text,
          phonetic: p.mundari_phonetic,
          root: p.mundari_root || "",
          numeral: null,
          audio_file: p.audio_file || null,
          status: "VERIFIED_EDUCATIONAL_LOOKUP",
          badge: "● VERIFIED_EDUCATIONAL_LOOKUP (MUNDARI ➔ HINDI)",
          badgeClass: "verified",
          provenance: "Classroom Phrasebook (Mundari Instruction: " + p.mundari_text + " ➔ " + p.hindi_text + ")",
          isBroadcastable: true,
          direction: direction
        };
      }
    }

    // 3. Known carrier prompt in reverse
    if (normalized.includes("होपोनको") || normalized.includes("इतुना") || normalized.includes("बाबतातेबो")) {
      return {
        source: clean,
        mundari: "बच्चों, आज हम एक सेब के बारे में सीखेंगे।",
        hindi: "बच्चों, आज हम एक सेब के बारे में सीखेंगे।",
        targetText: "बच्चों, आज हम एक सेब के बारे में सीखेंगे।",
        phonetic: "",
        root: "",
        numeral: 1,
        audio_file: null,
        status: "COMPOSED_FROM_ATTESTED_FRAGMENTS",
        badge: "⚠ COMPOSED_FROM_ATTESTED_FRAGMENTS (UNVERIFIED_SENTENCE)",
        badgeClass: "warn",
        provenance: "Reverse carrier frame derived from classroom prompt. Full sentence is UNVERIFIED and NOT attested in parallel corpus.",
        isBroadcastable: false,
        direction: direction,
        fallbackHint: "Full sentence is unverified and cannot be broadcast."
      };
    }

    // 4. Fallback for Mundari input
    return {
      source: clean,
      mundari: "[Mundari term unattested in canonical registry — This phrase is not available in the verified classroom vocabulary.]",
      hindi: null,
      targetText: "[Mundari term unattested in canonical registry — This phrase is not available in the verified classroom vocabulary.]",
      phonetic: "",
      root: "",
      numeral: null,
      audio_file: null,
      status: "OUT_OF_VOCABULARY",
      badge: "⚠ OUT_OF_VOCABULARY (UNVERIFIED)",
      badgeClass: "danger",
      provenance: "This phrase is not available in the verified classroom vocabulary. Mundari expression not attested in canonical classroom registry or phrasebook. Broadcast suppressed to prevent unverified terminology.",
      isBroadcastable: false,
      direction: direction,
      fallbackHint: "This phrase is not available in the verified classroom vocabulary. Select an attested Mundari numeral (मिअद, बारिया, अपिया, उपुनिया, मोड़ेया) or classroom phrase (जोहार, दुबपे, लेकापे, ओलपे) from Learning Modules or quick buttons."
    };
  }

  // -------------------------------------------------------------
  // FORWARD TRANSLATION: HINDI ➔ MUNDARI (Default)
  // -------------------------------------------------------------
  // 1. Exact canonical lookup against numbers 1-20
  for (let item of DB.numbers) {
    const normItemHi = normalizeHindi(item.hindi_text);
    const lookupItemHi = normalizeForLookup(item.hindi_text);
    const normItemMun = normalizeHindi(item.mundari_text);
    const lookupItemMun = normalizeForLookup(item.mundari_text);

    if (
      clean === item.hindi_text ||
      normalized === normItemHi ||
      lookupClean === lookupItemHi ||
      clean === String(item.number) ||
      clean === item.hindi_numeral ||
      clean === item.mundari_text ||
      normalized === normItemMun ||
      lookupClean === lookupItemMun
    ) {
      return {
        source: clean,
        mundari: item.mundari_text,
        phonetic: item.mundari_phonetic,
        root: item.mundari_root,
        numeral: item.number,
        audio_file: item.audio_file || null,
        status: "EXACT_CANONICAL_LOOKUP",
        badge: "● EXACT_CANONICAL_LOOKUP (CORPUS_ATTESTED)",
        badgeClass: "verified",
        provenance: "Canonical FLN Registry (Grade 1 Numeracy Demonstration Module)",
        isBroadcastable: true,
        direction: direction
      };
    }
  }

  // 2. Exact match against classroom phrasebook (33 verified & composed phrases)
  const allPhrases = DB.phrasebook.concat(DB.expandedPhrasebook || []);
    for (let p of allPhrases) {
    const normPHi = normalizeHindi(p.hindi_text);
    const lookupPHi = normalizeForLookup(p.hindi_text);
    const normPMun = normalizeHindi(p.mundari_text);
    const lookupPMun = normalizeForLookup(p.mundari_text);

    const isDirect = clean === p.hindi_text || normalized === normPHi || lookupClean === lookupPHi;
    const isMundari = clean === p.mundari_text || normalized === normPMun || lookupClean === lookupPMun;
    const isVariant = Array.isArray(p.hindi_variants) && p.hindi_variants.some(v => clean === v || normalized === normalizeHindi(v) || lookupClean === normalizeForLookup(v));

    if (isDirect || isMundari || isVariant) {
      const isComposed = p.verification_level === "COMPOSED_FROM_ATTESTED_FRAGMENTS";
      const statusText = isComposed ? "COMPOSED_FROM_ATTESTED_FRAGMENTS" : "CORPUS_ATTESTED";
      const badgeText = isComposed ? "⚠ COMPOSED_FROM_ATTESTED_FRAGMENTS" : ("● CORPUS_ATTESTED (" + (p.category || "CLASSROOM") + ")");
      const badgeClass = isComposed ? "warn" : "verified";
      return {
        source: clean,
        mundari: p.mundari_text,
        phonetic: p.mundari_phonetic || "",
        root: p.mundari_root || "",
        numeral: null,
        audio_file: p.audio_file || null,
        status: statusText,
        badge: badgeText,
        badgeClass: badgeClass,
        provenance: "Classroom Phrasebook (" + (p.provenance || p.category || "Verified FLN Attestation") + ")",
        isBroadcastable: !isComposed,
        direction: direction
      };
    }
  }

  // 3. Known Primary Lesson Prompts / Concept Extraction (e.g. demo sentence)
  if (normalized === normalizeHindi(demoHindi) || (normalized.startsWith("बच्चों") && normalized.includes("सेब"))) {
    let matchedNum = DB.numbers[0];
    for (let item of DB.numbers) {
      if (normalized.includes(item.hindi_text) || normalized.includes(item.hindi_numeral)) {
        matchedNum = item;
        break;
      }
    }
    return {
      source: clean,
      mundari: "होपोनको, तेहेंज आबु " + matchedNum.mundari_text + " सेब बाबतातेबो इतुना। (" + matchedNum.mundari_text + " - " + matchedNum.mundari_phonetic + ")",
      phonetic: "Hoponko, tehenj aabu " + matchedNum.mundari_phonetic + " seb babatatebo ituna.",
      root: matchedNum.mundari_root,
      numeral: matchedNum.number,
      audio_file: matchedNum.audio_file || null,
      status: "COMPOSED_FROM_ATTESTED_FRAGMENTS",
      badge: "⚠ COMPOSED_FROM_ATTESTED_FRAGMENTS (UNVERIFIED_SENTENCE)",
      badgeClass: "warn",
      provenance: "Composed from synthetic carrier frame + attested concept slot [content_registry.json -> num_" + (matchedNum.number < 10 ? "0" + matchedNum.number : matchedNum.number) + " (" + matchedNum.hindi_text + " -> " + matchedNum.mundari_text + ")]. Full sentence is UNVERIFIED and NOT attested in parallel corpus.",
      isBroadcastable: false,
      direction: direction,
      fallbackHint: "Full sentence is unverified and cannot be broadcast."
    };
  }

  // 4. Out-of-Vocabulary / Unattested Input Fallback
  return {
    source: clean,
    mundari: "[Unattested in FLN Registry — This phrase is not available in the verified classroom vocabulary.]",
    phonetic: "",
    root: "",
    numeral: null,
    audio_file: null,
    status: "OUT_OF_VOCABULARY",
    badge: "⚠ OUT_OF_VOCABULARY (UNVERIFIED)",
    badgeClass: "danger",
    provenance: "This phrase is not available in the verified classroom vocabulary. Broadcast suppressed to protect learner language acquisition.",
    isBroadcastable: false,
    direction: direction,
    fallbackHint: "This phrase is not available in the verified classroom vocabulary. Select an attested number (1–20) or classroom phrase (e.g. नमस्ते, बैठो, चुप रहो) from Learning Modules or quick buttons."
  };
}

// RENDERING TEN-FRAME (FLN FOUNDATIONAL NUMERACY VISUAL AID)
function renderMiniTenFrame(count) {
  const c = parseInt(count, 10) || 0;
  if (c <= 10) {
    let dots = "";
    for (let i = 0; i < 10; i++) {
      dots += (i < c) ? '<div class="mini-dot"></div>' : '<div class="mini-dot-empty"></div>';
    }
    return '<div class="mini-ten-frame-container"><div class="mini-ten-frame">' + dots + '</div></div>';
  } else {
    let dots1 = "", dots2 = "";
    const rem = c - 10;
    for (let i = 0; i < 10; i++) {
      dots1 += '<div class="mini-dot"></div>';
      dots2 += (i < rem) ? '<div class="mini-dot"></div>' : '<div class="mini-dot-empty"></div>';
    }
    return '<div class="mini-ten-frame-container" title="10 + ' + rem + ' = ' + c + '"><div class="mini-ten-frame">' + dots1 + '</div><div class="mini-ten-frame">' + dots2 + '</div></div>';
  }
}

function renderTenFrame(count) {
