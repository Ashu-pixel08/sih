.quiz-feedback-banner.correct {
  background: #ecfdf5;
  border: 2px solid #86efac;
  color: #065f46;
}
.quiz-feedback-banner.incorrect {
  background: #fef2f2;
  border: 2px solid #fca5a5;
  color: #991b1b;
}

