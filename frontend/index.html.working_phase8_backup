  const isVerified = (apiRes.translation_source === "EDUCATIONAL_REGISTRY" || apiRes.status === "VERIFIED_EDUCATIONAL_LOOKUP" || apiRes.status === "EXACT_CANONICAL_LOOKUP" || apiRes.status === "CORPUS_ATTESTED");
