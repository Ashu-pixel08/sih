/* --- Continuous Voice Orb Experience Styles --- */
.voice-mode-workspace {
  width: 100%;
  max-width: 920px;
  margin: 0 auto;
  box-sizing: border-box;
}
.voice-hero-panel {
  background: linear-gradient(145deg, #05140d 0%, #0A2418 45%, #144e34 100%);
  color: #fff;
  border-radius: 22px;
  padding: 22px 28px 18px;
  box-shadow: 0 16px 48px rgba(10,36,24,0.32);
  border: 1px solid rgba(255,255,255,0.14);
  position: relative;
  overflow: hidden;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  margin: 0 0 16px;
}
.voice-hero-panel::before {
  content: "";
  position: absolute;
  top: -120px;
  right: -120px;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(231,199,91,0.09) 0%, rgba(231,199,91,0) 70%);
  pointer-events: none;
}
.voice-hero-panel::after {
  content: "";
  position: absolute;
  bottom: -100px;
  left: -100px;
  width: 280px;
  height: 280px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34,197,94,0.08) 0%, rgba(34,197,94,0) 70%);
  pointer-events: none;
}

.mic, .voice-orb {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  position: relative;
  display: grid;
  place-items: center;
  cursor: pointer;
  border: none;
  outline: none;
  user-select: none;
  margin: 6px auto 10px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: visible;
}
.mic:hover, .voice-orb:hover {
  transform: scale(1.04);
}

/* Translucent Glass Depth & Highlights */
.voice-orb::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0.06) 35%, rgba(0, 0, 0, 0.4) 85%, rgba(0, 0, 0, 0.7) 100%);
  box-shadow: inset 0 2px 6px rgba(255, 255, 255, 0.38), inset 0 -4px 12px rgba(0, 0, 0, 0.5);
  pointer-events: none;
  z-index: 2;
}

/* Outer Specular Rim Highlight */
.voice-orb::after {
  content: "";
  position: absolute;
  inset: 3px;
  border-radius: 50%;
  border: 1.5px solid rgba(255, 255, 255, 0.2);
  pointer-events: none;
  z-index: 3;
}

.orb-3d-centerpiece {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  position: relative;
  z-index: 1;
}

.orb-3d-svg, .orb-visual-svg {
  width: 108px;
  height: 108px;
  overflow: visible;
  filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.45));
}

.orb-core {
  fill: url(#orbGradReady);
  transition: fill 0.35s ease;
}
.voice-orb.ready .orb-core { fill: url(#orbGradReady); }
.voice-orb.listening .orb-core { fill: url(#orbGradListening); }
.voice-orb.processing .orb-core { fill: url(#orbGradProcessing); }
.voice-orb.translating .orb-core { fill: url(#orbGradTranslating); }
.voice-orb.speaking .orb-core { fill: url(#orbGradSpeaking); }
.voice-orb.interrupted .orb-core { fill: url(#orbGradInterrupted); }
.voice-orb.error .orb-core { fill: url(#orbGradError); }

.orb-glow-layer { fill: rgba(231, 199, 91, 0.12); transition: fill 0.3s; }
.wave-ring { stroke: rgba(167, 243, 208, 0.35); stroke-width: 1.5; fill: none; transition: all 0.3s; }
.ring-outer { stroke-dasharray: 4 3; }
.ring-mid { stroke: rgba(254, 240, 138, 0.35); }
.orb-specular { fill: rgba(255, 255, 255, 0.6); filter: blur(0.8px); }
.bar, .eq-bar { fill: #fef08a; transform-origin: 50% 50%; transition: all 0.2s ease; }

/* Equalizer animations during LISTENING and SPEAKING */
.voice-orb.listening .bar-1, .voice-orb.listening .eq-bar.bar-1 { animation: eq-bounce 0.8s ease-in-out infinite 0.1s; }
.voice-orb.listening .bar-2, .voice-orb.listening .eq-bar.bar-2 { animation: eq-bounce 0.7s ease-in-out infinite 0.25s; }
.voice-orb.listening .bar-3, .voice-orb.listening .eq-bar.bar-3 { animation: eq-bounce 0.6s ease-in-out infinite 0.0s; }
.voice-orb.listening .bar-4, .voice-orb.listening .eq-bar.bar-4 { animation: eq-bounce 0.75s ease-in-out infinite 0.3s; }
.voice-orb.listening .bar-5, .voice-orb.listening .eq-bar.bar-5 { animation: eq-bounce 0.85s ease-in-out infinite 0.15s; }

.voice-orb.speaking .bar-1, .voice-orb.speaking .eq-bar.bar-1 { animation: eq-bounce 0.5s ease-in-out infinite 0.05s; fill: #6ee7b7; }
.voice-orb.speaking .bar-2, .voice-orb.speaking .eq-bar.bar-2 { animation: eq-bounce 0.45s ease-in-out infinite 0.15s; fill: #6ee7b7; }
.voice-orb.speaking .bar-3, .voice-orb.speaking .eq-bar.bar-3 { animation: eq-bounce 0.4s ease-in-out infinite 0.0s; fill: #6ee7b7; }
.voice-orb.speaking .bar-4, .voice-orb.speaking .eq-bar.bar-4 { animation: eq-bounce 0.48s ease-in-out infinite 0.2s; fill: #6ee7b7; }
.voice-orb.speaking .bar-5, .voice-orb.speaking .eq-bar.bar-5 { animation: eq-bounce 0.52s ease-in-out infinite 0.1s; fill: #6ee7b7; }

.voice-orb.processing .ring-outer { animation: ring-rotate 2.5s linear infinite; stroke: rgba(245, 158, 11, 0.7); }
.voice-orb.translating .wave-ring { stroke: rgba(96, 165, 250, 0.8); animation: ring-expand 1.2s ease-out infinite; }

@keyframes eq-bounce {
  0%, 100% { transform: scaleY(0.45); }
  50% { transform: scaleY(1.35); }
}
@keyframes ring-rotate {
  from { transform: rotate(0deg); transform-origin: 50px 50px; }
  to { transform: rotate(360deg); transform-origin: 50px 50px; }
}
@keyframes ring-expand {
  0% { transform: scale(0.92); opacity: 0.8; transform-origin: 50px 50px; }
  50% { transform: scale(1.1); opacity: 0.25; transform-origin: 50px 50px; }
  100% { transform: scale(0.92); opacity: 0.8; transform-origin: 50px 50px; }
}

