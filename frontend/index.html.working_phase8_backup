function studentAudio() {
  if (!state.lastTranslation) return toast("Waiting for teacher broadcast");
  const d = state.lastTranslation;
  const isRev = (d.direction === "unr-hi");
  const targetText = isRev ? (d.hindi || d.translated_text || d.mundari) : d.mundari;
  const lang = isRev ? "hindi" : "mundari";

  playBackendPronunciation({
    text: targetText,
    language: lang
  });
}

function speakMundari(text, audioUrl) {
  if (typeof process !== "undefined" && audioUrl) {
    playDemoPulse();
    const cleanUrl = audioUrl.replace(/\\/g, "/");
    let a = new Audio(cleanUrl);
    a.play().catch(() => {});
    return;
  }
  playBackendPronunciation({
    text: text,
    language: "mundari"
  });
}

function fallbackSpeech(text, lang) {
  playBackendPronunciation({
    text: text,
    language: lang || "hindi"
  });
}

function leaveRoom() {
  state.joined = false;
  state.lastTranslation = null;
  save();
  go("home");
}

