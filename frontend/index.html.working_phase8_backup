  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8faf9 0%, #edf4f0 100%);
  border-radius: 18px;
  border: 1.5px solid #e1e9e4;
  padding: 14px;
  margin: 16px auto;
}
.student-flashcard-img {
  max-height: 100%;
  max-width: 100%;
  object-fit: contain;
  border-radius: 12px;
}

