/* READY: slow subtle breathing pulse */
.voice-orb.ready, .mic.ready {
  background: radial-gradient(circle at 35% 35%, #15803d 0%, #064e3b 55%, #022c22 100%);
  box-shadow: 0 0 0 12px rgba(34, 197, 94, 0.18), 0 0 45px rgba(34, 197, 94, 0.25), 0 12px 32px rgba(0, 0, 0, 0.4);
  animation: orb-pulse-ready 3.2s ease-in-out infinite;
}
@keyframes orb-pulse-ready {
  0% { box-shadow: 0 0 0 10px rgba(34, 197, 94, 0.18), 0 0 35px rgba(34, 197, 94, 0.22); transform: scale(1); }
  50% { box-shadow: 0 0 0 20px rgba(34, 197, 94, 0.08), 0 0 52px rgba(34, 197, 94, 0.35); transform: scale(1.025); }
  100% { box-shadow: 0 0 0 10px rgba(34, 197, 94, 0.18), 0 0 35px rgba(34, 197, 94, 0.22); transform: scale(1); }
}

/* LISTENING: active emerald ripple/pulse */
.voice-orb.listening, .mic.listening {
  background: radial-gradient(circle at 35% 35%, #22c55e 0%, #15803d 70%, #052e16 100%) !important;
  animation: orb-pulse-listening 1.4s ease-in-out infinite !important;
}
@keyframes orb-pulse-listening {
  0% { box-shadow: 0 0 0 10px rgba(34,197,94,0.48), 0 0 40px rgba(34,197,94,0.45); transform: scale(1); }
  50% { box-shadow: 0 0 0 32px rgba(34,197,94,0.12), 0 0 70px rgba(34,197,94,0.65); transform: scale(1.07); }
  100% { box-shadow: 0 0 0 10px rgba(34,197,94,0.48), 0 0 40px rgba(34,197,94,0.45); transform: scale(1); }
}

/* PROCESSING: warm amber rotation/pulse */
.voice-orb.processing {
  background: radial-gradient(circle at 35% 35%, #f59e0b 0%, #b45309 70%, #451a03 100%) !important;
  animation: orb-pulse-processing 1s ease-in-out infinite !important;
}
@keyframes orb-pulse-processing {
  0% { box-shadow: 0 0 0 10px rgba(245,158,11,0.5), 0 0 40px rgba(245,158,11,0.4); transform: scale(1.02); }
  50% { box-shadow: 0 0 0 24px rgba(245,158,11,0.15), 0 0 60px rgba(245,158,11,0.55); transform: scale(0.98); }
  100% { box-shadow: 0 0 0 10px rgba(245,158,11,0.5), 0 0 40px rgba(245,158,11,0.4); transform: scale(1.02); }
}

/* TRANSLATING: blue/indigo wave pulse */
.voice-orb.translating {
  background: radial-gradient(circle at 35% 35%, #3b82f6 0%, #1d4ed8 70%, #172554 100%) !important;
  animation: orb-pulse-translating 0.9s ease-in-out infinite !important;
}
@keyframes orb-pulse-translating {
  0% { box-shadow: 0 0 0 10px rgba(59,130,246,0.5), 0 0 40px rgba(59,130,246,0.4); transform: scale(1); }
  50% { box-shadow: 0 0 0 26px rgba(59,130,246,0.14), 0 0 65px rgba(59,130,246,0.6); transform: scale(1.06); }
  100% { box-shadow: 0 0 0 10px rgba(59,130,246,0.5), 0 0 40px rgba(59,130,246,0.4); transform: scale(1); }
}

/* SPEAKING: vibrant teal soundwave pulse */
.voice-orb.speaking {
  background: radial-gradient(circle at 35% 35%, #10b981 0%, #047857 70%, #022c22 100%) !important;
  animation: orb-pulse-speaking 0.85s ease-in-out infinite !important;
}
@keyframes orb-pulse-speaking {
  0% { box-shadow: 0 0 0 8px rgba(16,185,129,0.5), 0 0 35px rgba(16,185,129,0.45); transform: scale(1); }
  50% { box-shadow: 0 0 0 30px rgba(16,185,129,0.15), 0 0 70px rgba(16,185,129,0.65); transform: scale(1.08); }
  100% { box-shadow: 0 0 0 8px rgba(16,185,129,0.5), 0 0 35px rgba(16,185,129,0.45); transform: scale(1); }
}

/* INTERRUPTED: energetic flash/shake */
.voice-orb.interrupted {
  background: radial-gradient(circle at 35% 35%, #f97316 0%, #c2410c 70%, #431407 100%) !important;
  animation: orb-pulse-interrupted 0.35s ease-in-out 2 !important;
  box-shadow: 0 0 0 22px rgba(249,115,22,0.45), 0 0 55px rgba(249,115,22,0.6) !important;
}
@keyframes orb-pulse-interrupted {
  0% { transform: scale(1) rotate(0deg); }
  25% { transform: scale(1.08) rotate(-4deg); }
  75% { transform: scale(1.08) rotate(4deg); }
  100% { transform: scale(1) rotate(0deg); }
}

/* ERROR: muted red glow */
.voice-orb.error {
  background: radial-gradient(circle at 35% 35%, #ef4444 0%, #b91c1c 70%, #450a0a 100%) !important;
  box-shadow: 0 0 0 14px rgba(239,68,68,0.35), 0 0 45px rgba(239,68,68,0.45) !important;
}

