      case VoiceStateEnum.TRANSLATING:
        sessionBtn.innerHTML = "Translating…";
        sessionBtn.style.background = "#2563eb";
        sessionBtn.style.boxShadow = "0 6px 20px rgba(37,99,235,0.4)";
