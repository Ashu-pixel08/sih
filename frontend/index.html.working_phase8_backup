async function loadTeacherVoiceStatus() {
  try {
    const res = await fetch("/api/teacher-voice/status");
    if (res.ok) {
      const data = await res.json();
      state.teacherVoiceStatus = data;
      updateTeacherVoiceUI();
    }
  } catch (e) {
    console.warn("Could not load teacher voice status:", e);
  }
}
