function initBus() {
  if (!state.room) return;
  const name = "vfln-classroom-" + state.room;
  if ("BroadcastChannel" in window) {
    state.channel = new BroadcastChannel(name);
    state.channel.onmessage = e => receive(e.data);
  }
  window.addEventListener("storage", e => {
    if (e.key === "vflnLiveBus" && e.newValue) {
      try {
        let d = JSON.parse(e.newValue);
        if (d.room === state.room) receive(d);
      } catch (err) {}
    }
  });
}

function sendBus(data) {
  data.room = state.room;
  data.sentAt = Date.now();
  if (state.channel) state.channel.postMessage(data);
  localStorage.setItem("vflnLiveBus", JSON.stringify(data));
}

function receive(d) {
  if (d.type === "join" && state.role === "teacher") {
    if (!state.students.includes(d.name)) {
      state.students.push(d.name);
      render();
    }
    toast(d.name + " joined the classroom");
  }
  if (d.type === "student_reply" && state.role === "teacher") {
    toast(d.name + ": " + d.text);
    addTeacherFeed({ hindi: "[Student Reply] " + d.name, mundari: d.text, time: d.time || now() });
  }
  if (d.type === "translation" && state.role === "student" && (state.joined || state.page === "demo")) {
    state.lastTranslation = d;
    render();
    playDemoPulse();
    toast("Broadcast received: " + d.mundari);
  }
  if (d.type === "broadcast_vocab" && state.role === "student") {
    state.lastVocabBroadcast = d.card;
    render();
    toast("🎴 Flashcard from teacher: " + (d.card.english || d.card.hindi));
  }
  if (d.type === "broadcast_practice" && state.role === "student") {
    state.lastPracticeBroadcast = d.question;
    render();
    toast("✍️ Practice question pushed by teacher!");
  }
  if (d.type === "end" && state.role === "student") {
    state.joined = false;
    render();
    toast("Teacher ended the live class");
  }
}

