  .quiz-options-grid { grid-template-columns: 1fr; }
}
.quiz-option-btn {
  background: #ffffff;
  border: 2px solid #e2e8f0;
  border-radius: 18px;
  padding: 16px 20px;
  font-size: 16px;
  font-weight: 700;
  color: #1e293b;
