function translateCurriculum() {
  const input = $("#currInput").value;
  let res = "📖 Curriculum Matches:\n\n";
  let matchedCount = 0;

  // Search exact canonical numbers
  for (let it of DB.numbers) {
    if (input.includes(it.hindi_text)) {
      res += `• [Number] "${it.hindi_text}" (${it.number}) ➔ "${it.mundari_text}" (/${it.mundari_phonetic}/)\n`;
      matchedCount++;
    }
  }

  // Search exact phrasebook commands
  const allPhrases = DB.phrasebook.concat(DB.expandedPhrasebook || []);
  for (let p of allPhrases) {
    if (input.includes(p.hindi_text)) {
      res += `• [${p.category}] "${p.hindi_text}" ➔ "${p.mundari_text}" (/${p.mundari_phonetic}/)\n`;
      matchedCount++;
    }
  }

  if (matchedCount === 0) {
    res += `• No matching lesson phrases found in the curriculum database.\n• Status: Please review this text before classroom use.`;
  } else {
    res += `\nTotal Curriculum Matches: ${matchedCount}`;
  }

  $("#currOutput").textContent = res;
  toast("Curriculum translated");
}

