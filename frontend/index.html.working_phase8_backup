  else if (isHinglish) defaultInput = "namaste";

  const initialTrans = state.lastTranslation || backendTranslate(defaultInput, state.translationDirection);

  const getFriendlyStatus = (t) => {
    if (!t) return { text: "Ready", badgeClass: "verified" };
    if (t.status === "OUT_OF_VOCABULARY" || t.status === "OUT_OF_VOCABULARY_UNVERIFIED") {
      return { text: "Translation unavailable for this content.", badgeClass: "danger" };
    }
    if (t.isBroadcastable || t.status === "VERIFIED_EDUCATIONAL_LOOKUP" || t.translation_source === "EDUCATIONAL_REGISTRY") {
      return { text: "Verified classroom phrase", badgeClass: "verified" };
    }
    if (t.status === "EMPTY_INPUT") {
      return { text: "Awaiting input", badgeClass: "placeholder" };
    }
    return { text: "AI translation — review before classroom use", badgeClass: "warn" };
  };
  const initStatus = getFriendlyStatus(initialTrans);

