function isValidRoomCode(room) {
  if (!room || typeof room !== "string") return false;
  let r = room.trim().toUpperCase();
  if (r.startsWith("ROOM ")) r = r.slice(5).trim();
  return /^(MUN|DEMO)-\d{4}$/.test(r);
}

function cleanRoomCode(room) {
  if (!room || typeof room !== "string") return "";
  let r = room.trim().toUpperCase();
  if (r.startsWith("ROOM ")) r = r.slice(5).trim();
  return /^(MUN|DEMO)-\d{4}$/.test(r) ? r : "";
}

function getValidStoredRoom() {
  const stored = localStorage.getItem("vflnRoom");
  if (!stored) return "";
  const clean = cleanRoomCode(stored);
  if (!clean) {
    localStorage.removeItem("vflnRoom");
    return "";
  }
  return clean;
}

