function toggleDemoMic() {
  const b = $("#demoMicBtn");
  const st = $("#demoMicStatus");
  if (!("webkitSpeechRecognition" in window || "SpeechRecognition" in window)) {
    const msg = "Browser speech recognition requires network access in Chrome. Android app uses offline Vosk. Please use text input or preset buttons.";
    if (st) st.textContent = msg;
    return toast(msg);
  }
  if (b && b.classList.contains("listening")) return;
  const R = window.SpeechRecognition || window.webkitSpeechRecognition;
  const r = new R();
  r.lang = "hi-IN";
  r.interimResults = true;
  r.continuous = false;
  if (b) b.classList.add("listening");
  if (st) st.textContent = "Listening... Speak Hindi now.";
  toast("Microphone listening... Speak Hindi");
  r.onresult = e => {
    const transcript = Array.from(e.results).map(x => x[0].transcript).join("");
    const inputEl = $("#demoHindiInput");
    if (inputEl) inputEl.value = transcript;
    runDemoTranslate();
  };
  r.onend = () => {
    if (b) b.classList.remove("listening");
    if (st) st.textContent = "Hindi speech captured and processed.";
  };
  r.onerror = e => {
    if (b) b.classList.remove("listening");
    const err = e.error || "unknown";
    let msg = "Microphone error (" + err + "). Browser speech recognition requires network access in Chrome. Android app uses offline Vosk.";
    if (err === "not-allowed" || err === "permission-denied") {
      msg = "Microphone access denied. Browser speech recognition requires network access in Chrome. Android app uses offline Vosk.";
    } else if (err === "no-speech") {
      msg = "No speech detected. Please speak closer to the microphone or click preset buttons.";
    }
    if (st) st.textContent = msg;
    toast(msg);
  };
  try {
    r.start();
  } catch (err) {
    if (b) b.classList.remove("listening");
    if (st) st.textContent = "Could not initialize microphone: " + err.message;
    toast("Microphone error: " + err.message);
  }
}

