function updateTeacherVoiceUI() {
  const pill = document.getElementById("teacherVoiceStatusPill");
  const dot = document.getElementById("teacherVoiceDot");
  const label = document.getElementById("teacherVoiceLabel");
  const toggleBtn = document.getElementById("teacherVoiceToggleBtn");

  const status = state.teacherVoiceStatus;
  const isEnrolled = status && status.enrolled && status.model_available;
  const isEnabled = state.teacherVoiceEnabled && isEnrolled;

  if (toggleBtn) {
    toggleBtn.innerHTML = isEnabled ? "🎙️ Voice: On" : "🎙️ Voice: Off";
    toggleBtn.style.opacity = isEnrolled ? "1" : "0.5";
  }

  if (label && dot && pill) {
    if (!isEnrolled) {
      label.textContent = "Teacher voice unavailable";
      dot.style.background = "#9ca3af";
      pill.style.borderColor = "rgba(156,163,175,0.3)";
    } else if (!state.teacherVoiceEnabled) {
      label.textContent = "Teacher voice unavailable";
      dot.style.background = "#f59e0b";
      pill.style.borderColor = "rgba(245,158,11,0.3)";
    } else {
      label.textContent = "Teacher voice ready";
      dot.style.background = "#10b981";
      pill.style.borderColor = "rgba(16,185,129,0.3)";
    }
  }
}
window.updateTeacherVoiceUI = updateTeacherVoiceUI;

async function toggleTeacherVoice() {
  const nextState = !state.teacherVoiceEnabled;
  state.teacherVoiceEnabled = nextState;
  localStorage.setItem("vflnTeacherVoiceEnabled", String(nextState));

  try {
    const res = await fetch("/api/teacher-voice/toggle", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ enabled: nextState })
    });
    if (res.ok) {
      state.teacherVoiceStatus = await res.json();
    }
  } catch (e) {
    console.warn("Toggle teacher voice error:", e);
  }

  updateTeacherVoiceUI();
  toast(nextState ? "Teacher voice profile enabled" : "Teacher voice profile disabled");
}
window.toggleTeacherVoice = toggleTeacherVoice;

async function deleteTeacherVoiceProfile() {
  if (!confirm("Are you sure you want to delete your local teacher voice profile? This cannot be undone.")) {
    return;
  }
  try {
    const res = await fetch("/api/teacher-voice/profile", {
      method: "DELETE"
    });
    if (res.ok) {
      state.teacherVoiceEnabled = false;
