<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#24543D">
<title>Bhasha Setu — Learn in Your Language. Teach with Confidence.</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
:root {
  --green: #0A2418;
  --green-dark: #06170F;
  --green-mid: #16563A;
  --green-light: #248259;
  --sage: #4F8A5B;
  --soft: #EBF5F0;
  --soft-bg: #F5F8F6;
  --cream: #F7F3EA;
  --white: #FFFFFF;
  --amber: #F59E0B;
  --orange: #EA580C;
  --yellow: #E7C75B;
  --terr: #A86145;
  --ink: #1C2B22;
  --muted: #627368;
  --line: #DFE8E2;
  --danger: #DC2626;
  --shadow: 0 8px 28px rgba(38,51,44,.08);
  --shadow-lg: 0 16px 40px rgba(38,51,44,.12);
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: 'Plus Jakarta Sans', Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  color: var(--ink);
  background: var(--soft-bg);
  -webkit-font-smoothing: antialiased;
}
h1, h2, h3, .title, .number, .stat {
  font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
}
button, input, textarea, select { font: inherit; }
button { cursor: pointer; border: 0; }
.hidden { display: none !important; }
.app { min-height: 100vh; }
.topbar {
  height: 68px;
  background: var(--green);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  position: sticky;
  top: 0;
  z-index: 50;
  box-shadow: 0 2px 14px rgba(0,0,0,0.16);
}
.brand { display: flex; gap: 12px; align-items: center; text-decoration: none; color: inherit; }
.logo {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: var(--yellow);
  color: var(--green);
  display: grid;
  place-items: center;
  font-weight: 900;
  font-size: 22px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  flex-shrink: 0;
}
.brand b { font-size: 18px; font-weight: 800; letter-spacing: -0.01em; }
.brand small { display: block; opacity: .82; font-size: 11px; font-weight: 500; }
.userchip { display: flex; align-items: center; gap: 10px; font-size: 13px; }
.avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(255,255,255,0.18);
  display: grid;
  place-items: center;
  font-weight: 700;
}
.room-indicator {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 5px 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.16);
  font-size: 11px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.04em;
  border: 1px solid rgba(255, 255, 255, 0.22);
}
.pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 8px #4ade80;
  animation: pulse-dot 1.5s infinite;
}
@keyframes pulse-dot {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.3); opacity: 0.7; }
}
.layout { display: flex; min-height: calc(100vh - 68px); }
.sidebar {
  width: 250px;
  background: #fff;
  border-right: 1px solid var(--line);
  padding: 18px 12px;
  flex: none;
  display: flex;
  flex-direction: column;
}
.navtitle {
  font-size: 11px;
  text-transform: uppercase;
  color: var(--muted);
  padding: 10px 12px 6px;
  letter-spacing: .08em;
  font-weight: 700;
}
.nav {
  width: 100%;
  text-align: left;
  background: transparent;
  color: var(--ink);
  padding: 10px 12px;
  border-radius: 10px;
  margin: 2px 0;
  display: flex;
  gap: 12px;
  align-items: center;
  font-weight: 600;
  font-size: 13.5px;
  transition: all 0.15s ease;
}
.nav:hover { background: var(--soft); color: var(--green-light); transform: translateX(2px); }
.nav.active { background: var(--soft); color: var(--green-light); font-weight: 700; box-shadow: inset 3px 0 0 var(--green-light); }
.nav .ico { width: 22px; text-align: center; font-size: 16px; }
main { flex: 1; padding: 24px; min-width: 0; }
.page { max-width: 1250px; margin: auto; }
.eyebrow { color: var(--terr); font-weight: 800; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
.title { font-size: 30px; line-height: 1.15; margin: 5px 0 8px; font-weight: 800; color: var(--green); }
.sub { color: var(--muted); margin: 0 0 22px; font-size: 14.5px; line-height: 1.5; }
.grid { display: grid; gap: 16px; }
.g2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.g3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.g4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.card {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 20px;
  box-shadow: var(--shadow);
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.card:hover { box-shadow: var(--shadow-lg); }
.card h3 { margin: 0 0 7px; font-weight: 700; }
.card p { color: var(--muted); margin: 6px 0; }
.stat { font-size: 32px; font-weight: 900; color: var(--green-light); line-height: 1.1; }
.btn {
  padding: 11px 16px;
  border-radius: 10px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  font-size: 13.5px;
  transition: all 0.15s ease;
  cursor: pointer;
  border: 0;
}
.btn:hover { transform: translateY(-1px); }
.primary { background: var(--green-light); color: #fff; box-shadow: 0 3px 10px rgba(36, 130, 89, 0.2); }
.primary:hover { background: var(--green-mid); }
.secondary { background: var(--soft); color: var(--green-mid); }
.secondary:hover { background: #ddeadf; }
.outline { background: #fff; color: var(--green-mid); border: 1px solid #b9c9be; }
.outline:hover { background: var(--soft); }
.warn { background: #fff5d6; color: #735d11; border: 1px solid #fae69e; }
.danger { background: #fff0ee; color: var(--danger); border: 1px solid #fbd2ce; }
.row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.between { justify-content: space-between; }
.mt { margin-top: 16px; }
.mb { margin-bottom: 16px; }
input, textarea, select {
  width: 100%;
  padding: 12px;
  border: 1px solid #cfd9d1;
  border-radius: 10px;
  background: #fff;
  color: var(--ink);
  outline: none;
  font-size: 14.5px;
  transition: border-color 0.15s, box-shadow 0.15s;
}
input:focus, textarea:focus, select:focus {
  border-color: var(--green-light);
  box-shadow: 0 0 0 3px rgba(36, 130, 89, 0.15);
}
label { font-size: 12px; font-weight: 800; display: block; margin: 0 0 6px; color: var(--ink); }
.field { margin-bottom: 13px; }
.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.03em;
}
.live { background: #e4f4e8; color: #28653b; border: 1px solid #c2e2ca; }
.ai { background: #eee9fb; color: #624a93; border: 1px solid #dcd1f7; }
.placeholder { background: #fff7db; color: #715d17; border: 1px solid #fae69e; }
.offline { background: #eef0f1; color: #59645e; border: 1px solid #d5dbd7; }
.verified { background: #dff0e2; color: #1e5e2e; border: 1px solid #b7dcbe; }
.prototype { background: #f0f0f0; color: #555; border: 1px solid #ddd; }
.badge-verified { background: #dff0e2; color: #1e5e2e; border: 1px solid #b7dcbe; }
.badge-neural { background: #eee9fb; color: #5b21b6; border: 1px solid #c4b5fd; }
.badge-corpus { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
.badge-fallback { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
.hero {
  background: linear-gradient(135deg, #0A2418 0%, #16563A 55%, #248259 100%);
  color: #fff;
  border-radius: 20px;
  padding: 28px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8px 30px rgba(10,36,24,0.18);
}
.hero:after {
  content: "";
  position: absolute;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(231,199,91,0.22) 0%, rgba(231,199,91,0) 70%);
  right: -50px;
  top: -60px;
  pointer-events: none;
}
.hero h2 { font-size: 28px; margin: 0 0 8px; font-weight: 800; letter-spacing: -0.01em; }
.hero p { max-width: 680px; color: #edf5ef; font-size: 14.5px; line-height: 1.55; }
.hero .btn { background: var(--yellow); color: var(--green); font-weight: 800; box-shadow: 0 3px 12px rgba(0,0,0,0.15); }
.pipeline { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-top: 18px; }
.step {
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 12px;
  padding: 10px;
  text-align: center;
  font-size: 11px;
}
.step b { display: block; font-size: 16px; margin-bottom: 4px; }
.pipeline-step {
  background: #ffffff;
  border: 2px solid #e2e8f0;
  border-radius: 12px;
  padding: 10px 6px;
  text-align: center;
  font-size: 11px;
  transition: all .2s ease;
}
.pipeline-step b { display: block; font-size: 14px; margin-bottom: 3px; }
.pipeline-step.active-edu { border-color: #22c55e; background: #f0fdf4; box-shadow: 0 0 0 3px rgba(34,197,94,0.15); }
.pipeline-step.active-ai { border-color: #8b5cf6; background: #f5f3ff; box-shadow: 0 0 0 3px rgba(139,92,246,0.15); }
.pipeline-step.active-corpus { border-color: #f59e0b; background: #fffbeb; box-shadow: 0 0 0 3px rgba(245,158,11,0.15); }
.pipeline-step.active-safe { border-color: #94a3b8; background: #f8fafc; box-shadow: 0 0 0 3px rgba(148,163,184,0.15); }
.notice {
  padding: 12px 16px;
  border-radius: 12px;
  background: #fff8df;
  border: 1px solid #eadb9e;
  font-size: 12.5px;
  color: #66591e;
  line-height: 1.5;
}
.success { background: #edf7ef; border: 1px solid #bdd9c2; color: #2d6339; }
.dangerbox { background: #fff0ee; border: 1px solid #e3b8b3; color: #8a332e; }
.voicebox {
  border: 2px solid #d8e4da;
  background: #fbfdfb;
  border-radius: 18px;
  padding: 20px;
}
.voice-hero-panel {
  background: linear-gradient(145deg, #0A2418 0%, #16563A 100%);
  color: #fff;
  border-radius: 20px;
  padding: 26px;
  box-shadow: 0 10px 32px rgba(10,36,24,0.22);
  border: 1px solid rgba(255,255,255,0.12);
}
.mic, .voice-orb {
  width: 78px;
  height: 78px;
  border-radius: 50%;
  background: var(--terr);
  color: #fff;
  font-size: 30px;
  box-shadow: 0 0 0 9px rgba(168,97,69,0.18);
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: all 0.2s ease;
  border: none;
}
.mic:hover, .voice-orb:hover { transform: scale(1.05); box-shadow: 0 0 0 12px rgba(168,97,69,0.25); }
.mic.listening, .voice-orb.listening {
  animation: pulse-mic 1.2s infinite;
  background: #b53d37;
}
@keyframes pulse-mic {
  0% { box-shadow: 0 0 0 6px rgba(181,61,55,0.3); }
  50% { box-shadow: 0 0 0 22px rgba(181,61,55,0.06); }
  100% { box-shadow: 0 0 0 6px rgba(181,61,55,0.3); }
}
.transcript {
  min-height: 85px;
  background: #fff;
  border: 1px dashed #cbd8ce;
  border-radius: 12px;
  padding: 13px;
  line-height: 1.55;
  font-size: 15px;
}
.output {
  min-height: 85px;
  background: #f1f7f2;
  border: 1px solid #c7dbc9;
  border-radius: 12px;
  padding: 13px;
  line-height: 1.55;
  font-size: 18px;
  font-weight: 600;
  color: var(--green);
}
.audio {
  display: flex;
  align-items: center;
  gap: 10px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 11px;
}
.bar { height: 7px; background: #dfe8e1; border-radius: 999px; flex: 1; overflow: hidden; }
.bar span { display: block; width: 35%; height: 100%; background: var(--sage); transition: .2s; }
.room {
  font-size: 27px;
  letter-spacing: .14em;
  font-weight: 900;
  color: var(--green);
  background: var(--soft);
  border: 1px dashed #abc0af;
  border-radius: 12px;
  padding: 13px;
  text-align: center;
}
.student { display: flex; align-items: center; gap: 10px; padding: 10px; border-bottom: 1px solid var(--line); }
.student:last-child { border: 0; }
.dot { width: 9px; height: 9px; border-radius: 50%; background: #5fa56d; }
.small { font-size: 12px; color: var(--muted); }
.feed { max-height: 360px; overflow-y: auto; }
.feeditem { padding: 12px; border-bottom: 1px solid var(--line); }
.feeditem:last-child { border: 0; }
.feeditem .time { font-size: 10px; color: var(--muted); }
.login { min-height: 100vh; display: grid; place-items: center; padding: 20px; background: var(--soft-bg); }
.loginbox {
  width: min(530px, 100%);
  background: #fff;
  border-radius: 22px;
  border: 1px solid var(--line);
  padding: 32px;
  box-shadow: var(--shadow);
}
.rolegrid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.role {
  border: 2px solid var(--line);
  background: #fff;
  border-radius: 15px;
  padding: 18px;
  text-align: left;
  cursor: pointer;
  transition: all 0.15s ease;
}
.role:hover, .role.selected {
  border-color: var(--green-mid);
  background: var(--soft);
  transform: translateY(-2px);
}
.role strong { display: block; margin: 7px 0 4px; font-size: 15px; }
.role span { font-size: 12px; color: var(--muted); line-height: 1.4; display: block; }
.table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
.table th, .table td { padding: 12px; border-bottom: 1px solid var(--line); text-align: left; }
.table th { color: var(--muted); font-size: 11px; text-transform: uppercase; font-weight: 700; }
.flash {
  min-height: 220px;
  display: grid;
  place-items: center;
  text-align: center;
  background: var(--soft);
  border-radius: 16px;
  padding: 25px;
  border: 1px solid #d3e2d6;
}
.number { font-size: 54px; font-weight: 900; color: var(--green); }
.ten-frame {
  display: grid;
  grid-template-columns: repeat(5, 34px);
  grid-template-rows: repeat(2, 34px);
  gap: 5px;
  background: #fff;
  padding: 7px;
  border: 2px solid var(--green-mid);
  border-radius: 9px;
  margin: 10px auto;
  width: fit-content;
  box-shadow: 0 2px 6px rgba(0,0,0,0.06);
}
.ten-dot { width: 28px; height: 28px; border-radius: 50%; background: var(--terr); margin: auto; box-shadow: inset 0 2px 4px rgba(0,0,0,0.2); }
.ten-empty { width: 28px; height: 28px; border-radius: 50%; background: #e5eee7; margin: auto; }
.mobile-menu { display: none; }
.footer-note { font-size: 11px; color: var(--muted); margin-top: 20px; }
.preset-btn {
  text-align: left;
  padding: 9px 12px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 12px;
  transition: all .15s ease;
  border: 1px solid #cbd5e1;
  background: #fff;
  cursor: pointer;
  width: 100%;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.preset-btn:hover { transform: translateY(-1px); box-shadow: 0 3px 10px rgba(0,0,0,.08); }
.preset-edu { border-color: #86efac; background: #f0fdf4; color: #166534; }
.preset-ai { border-color: #c4b5fd; background: #faf5ff; color: #6b21a8; }
.preset-safe { border-color: #fca5a5; background: #fef2f2; color: #991b1b; }
@media(max-width:900px) {
  .sidebar { width: 210px; }
  .g4 { grid-template-columns: repeat(2, 1fr); }
  .pipeline { grid-template-columns: repeat(3, 1fr); }
}
@media(max-width:700px) {
  .topbar { padding: 0 12px; height: 60px; }
  .mobile-menu {
    display: block;
    background: rgba(255,255,255,0.15);
    color: #fff;
    border-radius: 9px;
    padding: 6px 9px;
    font-size: 16px;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
  }
  .brand { gap: 8px; }
  .logo { width: 32px; height: 32px; font-size: 16px; border-radius: 8px; }
  .brand b { font-size: 13.5px; }
  .brand small { display: none; }
  .room-indicator { display: none; }
  .demo-badge-btn { display: none; }
  .userchip { gap: 6px; }
  .userchip span { display: none; }
  .avatar { width: 28px; height: 28px; font-size: 12px; }
  .exit-btn { padding: 5px 8px !important; font-size: 11px !important; }
  .layout { display: block; }
  .sidebar {
    position: fixed;
    left: -270px;
    top: 60px;
    bottom: 0;
    z-index: 40;
    width: 260px;
    transition: left .25s ease;
    box-shadow: 8px 0 25px rgba(0,0,0,0.15);
  }
  .sidebar.open { left: 0; }
  main { padding: 14px; }
  .g2, .g3, .g4 { grid-template-columns: 1fr; }
  .pipeline { grid-template-columns: 1fr 1fr; }
  .title { font-size: 22px; }
}

/* --- Clean Educational Layer Extensions (Matching Native Design System) --- */
.category-pill-bar {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 6px;
  margin-bottom: 14px;
  scrollbar-width: thin;
}
.category-pill {
  padding: 6px 14px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: #fff;
  color: var(--ink);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.15s ease;
}
.category-pill:hover {
  background: var(--soft);
  color: var(--green-mid);
  border-color: var(--sage);
}
.category-pill.active {
  background: var(--green);
  color: #fff;
  border-color: var(--green);
}
.practice-thumb {
  max-height: 100px;
  max-width: 100%;
  object-fit: contain;
  border-radius: 8px;
  background: #f8faf9;
  margin-bottom: 6px;
}
.broadcast-spotlight-card {
  background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);
  border: 2px solid #86efac;
  border-radius: 16px;
  padding: 18px;
  margin-bottom: 18px;
  box-shadow: 0 4px 16px rgba(34,197,94,0.12);
}
@media print {
  body { background: #fff !important; }
  .topbar, .sidebar, .btn, .notice, .no-print, .hero, .category-pill-bar, #wsControlsArea { display: none !important; }
  main { padding: 0 !important; margin: 0 !important; width: 100% !important; }
  .page { max-width: 100% !important; margin: 0 !important; }
  #wsPrintableSheet { border: 1.5px solid #000 !important; box-shadow: none !important; padding: 12px !important; max-width: 100% !important; border-radius: 0 !important; }
}



/* --- Clean Teacher Command Center & Sidebar Extensions --- */
.btn-cta {
  background: #ea580c !important;
  color: #fff !important;
  font-weight: 800 !important;
  padding: 10px 22px !important;
  border-radius: 999px !important;
  box-shadow: 0 4px 16px rgba(234,88,12,0.32) !important;
  border: none !important;
  cursor: pointer !important;
  transition: all 0.15s ease !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 7px !important;
}
.btn-cta:hover {
  background: #c2410c !important;
  transform: translateY(-1px) !important;
  box-shadow: 0 6px 20px rgba(234,88,12,0.42) !important;
}

.hero-compact {
  background: linear-gradient(135deg, #073B2A 0%, #0B4A35 55%, #145A40 100%);
  color: #fff;
  border-radius: 18px;
  padding: 24px 28px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(7,59,42,0.16);
  border: 1px solid rgba(255,255,255,0.12);
}
.hero-compact::after {
  content: "";
  position: absolute;
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(231,199,91,0.16) 0%, rgba(231,199,91,0) 70%);
  right: -40px;
  top: -50px;
  pointer-events: none;
}

.hero-secondary-btn {
  background: rgba(255,255,255,0.12) !important;
  color: #fff !important;
  font-weight: 600 !important;
  font-size: 13.5px !important;
  padding: 10px 18px !important;
  border-radius: 999px !important;
  border: 1px solid rgba(255,255,255,0.24) !important;
  cursor: pointer !important;
