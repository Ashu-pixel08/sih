// TEXT NORMALIZER HELPER WITH PARITY TO PYTHON INDIC NORMALIZER
function normalizeHindi(text) {
  if (!text) return "";
  let s = String(text).normalize("NFC");
  // Strip zero-width characters (ZWJ, ZWNJ, BOM)
  s = s.replace(/[\u200b\u200c\u200d\ufeff]/g, "");
  const trimmed = s.trim();
  if (trimmed === "छ:" || trimmed === "छः" || trimmed === "छ") return "छह";
  // Indic punctuation and danda to space
  s = s.replace(/[\u0964\u0965।,!?;:\'\"\-—–()\[\]{}.\/\\*#@~`^+=<>|_]/g, " ");
  // Collapse whitespace
  return s.replace(/\s+/g, " ").trim();
}

function normalizeForLookup(text) {
  let s = normalizeHindi(text);
  if (!s) return "";
  const asciiMap = {"1":"एक","2":"दो","3":"तीन","4":"चार","5":"पाँच","6":"छह","7":"सात","8":"आठ","9":"नौ","10":"दस","11":"ग्यारह","12":"बारह","13":"तेरह","14":"चौदह","15":"पंद्रह","16":"सोलह","17":"सत्रह","18":"अठारह","19":"उन्नीस","20":"बीस"};
  const devMap = {"१":"एक","२":"दो","३":"तीन","४":"चार","५":"पाँच","६":"छह","७":"सात","८":"आठ","९":"नौ","१०":"दस","११":"ग्यारह","१२":"बारह","१३":"तेरह","१४":"चौदह","१५":"पंद्रह","१६":"सोलह","१७":"सत्रह","१८":"अठारह","१९":"उन्नीस","२०":"बीस"};
  if (asciiMap[s]) s = asciiMap[s];
  else if (devMap[s]) s = devMap[s];

  const aliases = {
    "पांच": "पाँच",
    "छः": "छह",
    "छ:": "छह",
    "छ": "छह",
    "पन्द्रह": "पंद्रह",
    "अट्ठारह": "अठारह",
    "उन्इस": "उन्नीस",
    "उनिस": "उन्नीस"
  };
  if (aliases[s]) s = aliases[s];
  s = s.replace(/\u0901/g, "\u0902");
  if (aliases[s]) s = aliases[s].replace(/\u0901/g, "\u0902");
  return s;
}


// HINGLISH NORMALIZER & LANGUAGE SELECTOR
function normalizeHinglish(text) {
  if (!text || typeof text !== "string") return { normalizedHindi: "", status: "EMPTY_INPUT", confidence: 1.0, originalText: "" };
  const raw = text.trim();
  if (!raw) return { normalizedHindi: "", status: "EMPTY_INPUT", confidence: 1.0, originalText: "" };

  const cleaned = raw.toLowerCase().replace(/[^\w\s\u0900-\u097F]/g, " ").replace(/\s+/g, " ").trim();
  if (!cleaned) return { normalizedHindi: raw, status: "EMPTY_INPUT", confidence: 1.0, originalText: raw };

  const lexicon = (DB && DB.hinglishLexicon) || [];

  if (!window._hinglishPhraseMap) {
    window._hinglishPhraseMap = {};
    window._hinglishWordMap = {};
    window._hinglishAmbiguous = new Set();
    for (let entry of lexicon) {
      const k = (entry.hinglish || "").trim().toLowerCase();
      if (!k) continue;
      if (entry.category === "AMBIGUOUS" || entry.status === "HELD_FOR_REVIEW") {
        window._hinglishAmbiguous.add(k);
      }
      if (k.includes(" ")) {
        window._hinglishPhraseMap[k] = entry;
      } else {
        window._hinglishWordMap[k] = entry;
      }
    }
  }

  // 1. Direct exact phrase match
  if (window._hinglishPhraseMap[cleaned]) {
    const e = window._hinglishPhraseMap[cleaned];
    return {
      originalText: raw,
      normalizedHindi: e.devanagari,
      status: e.status === "HELD_FOR_REVIEW" ? "AMBIGUOUS" : "EXACT_MATCH",
      confidence: e.status === "HELD_FOR_REVIEW" ? 0.4 : 1.0,
      notes: e.provenance || "Direct lexicon match"
    };
  }

  // 2. Direct exact word match
  if (window._hinglishWordMap[cleaned]) {
    const e = window._hinglishWordMap[cleaned];
    return {
      originalText: raw,
      normalizedHindi: e.devanagari,
      status: e.status === "HELD_FOR_REVIEW" ? "AMBIGUOUS" : "EXACT_MATCH",
      confidence: e.status === "HELD_FOR_REVIEW" ? 0.4 : 1.0,
      notes: e.provenance || "Direct lexicon match"
    };
  }

  // 3. Greedy multi-word phrase matching then token resolution
  let tokens = cleaned.split(" ");
  let i = 0;
  let outWords = [];
  let unmapped = [];
  let isAmbiguous = false;

  while (i < tokens.length) {
    let matched = false;
    for (let plen = Math.min(tokens.length - i, 4); plen >= 2; plen--) {
      let subPhrase = tokens.slice(i, i + plen).join(" ");
      if (window._hinglishPhraseMap[subPhrase]) {
        let e = window._hinglishPhraseMap[subPhrase];
        outWords.push(e.devanagari);
        if (window._hinglishAmbiguous.has(subPhrase)) isAmbiguous = true;
        i += plen;
        matched = true;
        break;
      }
    }
    if (matched) continue;

    let t = tokens[i];
    if (window._hinglishWordMap[t]) {
      let e = window._hinglishWordMap[t];
      outWords.push(e.devanagari);
      if (window._hinglishAmbiguous.has(t)) isAmbiguous = true;
    } else {
      if (/[\u0900-\u097F0-9]/.test(t)) {
        outWords.push(t);
      } else {
        outWords.push(t);
        unmapped.push(t);
      }
    }
    i++;
  }

  let finalNormalized = outWords.join(" ");
  if (unmapped.length > 0 && unmapped.length === tokens.length) {
    return {
      originalText: raw,
      normalizedHindi: raw,
      status: "UNRESOLVED",
      confidence: 0.0,
      unmappedTokens: unmapped,
      notes: "Unmapped Hinglish tokens"
    };
  }

  return {
    originalText: raw,
    normalizedHindi: finalNormalized,
    status: isAmbiguous ? "AMBIGUOUS" : (unmapped.length > 0 ? "PARTIAL" : "RULE_NORMALIZED"),
    confidence: isAmbiguous ? 0.4 : (unmapped.length > 0 ? 0.6 : 0.95),
    unmappedTokens: unmapped,
    notes: unmapped.length > 0 ? ("Partial match, unmapped: " + unmapped.join(", ")) : "Governed phrase/token normalization"
  };
}

function setInputMode(mode) {
  state.inputMode = mode;
  if (mode === "mundari") {
