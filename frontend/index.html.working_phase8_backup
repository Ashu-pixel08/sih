function toggleDirection() {
  if (state.translationDirection === "unr-hi") {
    state.translationDirection = "hi-unr";
    state.inputMode = (state.inputMode === "hinglish") ? "hinglish" : "hindi";
  } else {
    state.translationDirection = "unr-hi";
    state.inputMode = "mundari";
  }
  const currOut = $("#mundari") ? $("#mundari").value.trim() : "";
  if (currOut && !currOut.startsWith("[")) {
    if ($("#hindi")) $("#hindi").value = currOut;
  } else {
    if ($("#hindi")) $("#hindi").value = (state.translationDirection === "unr-hi") ? "मिअद" : (state.inputMode === "hinglish" ? "namaste" : "पाँच");
  }
  render();
  onHindiInput();
  toast("Translation direction set to: " + (state.translationDirection === "unr-hi" ? "Mundari ➔ Hindi" : "Hindi ➔ Mundari"));
}

function updateTranslationUI(res) {
  if (!res) return;
  state.currentTranslation = res;
  if ($("#mundari")) {
    if (res.status === "OUT_OF_VOCABULARY") {
      $("#mundari").value = "This sentence could not be translated yet.";
    } else {
      $("#mundari").value = res.mundari || "";
    }
  }
  const b = $("#transbadge");
  if (b) {
    if (res.isBroadcastable) {
      b.textContent = "Translation ready";
      b.className = "badge verified";
    } else if (res.status === "OUT_OF_VOCABULARY") {
      b.textContent = "Not translated";
      b.className = "badge danger";
    } else if (res.status === "EMPTY_INPUT") {
      b.textContent = "Awaiting input";
      b.className = "badge placeholder";
    } else {
      b.textContent = "Review needed";
      b.className = "badge warn";
    }
  }

  const sb = $("#transStatusBadge");
  if (sb) {
    if (res.status === "OUT_OF_VOCABULARY" || res.status === "OUT_OF_VOCABULARY_UNVERIFIED") {
      sb.textContent = "Translation unavailable for this content.";
      sb.className = "badge danger";
    } else if (res.isBroadcastable || res.status === "VERIFIED_EDUCATIONAL_LOOKUP" || res.translation_source === "EDUCATIONAL_REGISTRY") {
      sb.textContent = "Verified classroom phrase";
      sb.className = "badge verified";
    } else if (res.status === "EMPTY_INPUT") {
      sb.textContent = "Awaiting input";
      sb.className = "badge placeholder";
    } else {
      sb.textContent = "AI translation — review before classroom use";
      sb.className = "badge warn";
    }
  }

  const normEl = $("#hinglishNormStatus");
  if (normEl) {
    const normVal = res.normalizedHindi || (res.metadata && res.metadata.normalized_hindi);
    if (state.inputMode === "hinglish" && normVal && res.status !== "EMPTY_INPUT" && res.status !== "OUT_OF_VOCABULARY") {
      normEl.innerHTML = `<span style="color:#34d399;font-weight:700">✓ Normalized:</span> "${esc(res.source || "")}" ➔ <b style="color:#fde047">"${esc(normVal)}"</b>`;
      normEl.style.display = "block";
    } else if (state.inputMode === "hinglish" && res.status === "OUT_OF_VOCABULARY") {
      normEl.innerHTML = `<span style="color:#f87171;font-weight:700">⚠ Unresolved Hinglish:</span> Term not in classroom lexicon.`;
      normEl.style.display = "block";
    } else {
      normEl.style.display = "none";
    }
  }

  const tp = $("#transPhonetic");
  if (tp) {
    tp.innerHTML = res.phonetic ? `Phonetic: <i>${esc(res.phonetic)}</i>` : "";
  }

  const p = $("#provenanceBox");
  if (p) {
    p.style.display = "none";
    p.innerHTML = "<b>Linguistic Provenance:</b> " + esc(res.provenance);
  }

  const fb = $("#fallbackNoticeBox");
  if (fb) {
    if (res.status === "OUT_OF_VOCABULARY" || res.status === "OUT_OF_VOCABULARY_UNVERIFIED") {
      fb.style.display = "block";
      fb.className = "notice dangerbox mt";
      fb.innerHTML = "<b>Notice:</b> Translation unavailable for this content.";
    } else if (!res.isBroadcastable && res.status !== "EMPTY_INPUT") {
      fb.style.display = "block";
      fb.className = "notice warnbox mt";
      fb.innerHTML = "<b>Notice:</b> AI translation — review before classroom use.";
    } else {
      fb.style.display = "none";
    }
  }

  const bb = $("#broadcastBtn");
  if (bb) {
    if (!res.isBroadcastable) {
      bb.disabled = true;
      bb.style.opacity = "0.5";
      bb.style.cursor = "not-allowed";
      bb.title = "Please review this translation before classroom use.";
    } else {
      bb.disabled = false;
      bb.style.opacity = "1";
      bb.style.cursor = "pointer";
      bb.title = "";
    }
  }

  const ab = $("#playTeacherAudioBtn");
  if (ab) {
    const isRev = state.translationDirection === "unr-hi";
    if (isRev) {
      ab.disabled = false;
      ab.style.opacity = "1";
      ab.style.cursor = "pointer";
      ab.innerHTML = "🔊 Play in Hindi";
      ab.title = "Plays Hindi translation";
    } else if (res.status === "OUT_OF_VOCABULARY" || res.status === "EMPTY_INPUT" || !res.mundari) {
      ab.disabled = true;
      ab.style.opacity = "0.5";
      ab.style.cursor = "not-allowed";
      ab.innerHTML = "🔇 Audio not available";
      ab.title = "Audio is not available for this phrase yet.";
    } else {
      ab.disabled = false;
      ab.style.opacity = "1";
      ab.style.cursor = "pointer";
      ab.innerHTML = "🔊 Play pronunciation";
      ab.title = "Play pronunciation in Mundari";
    }
  }

  // Update Developer Diagnostics drawer for internal inspection
  const diagClass = $("#diagClass");
  if (diagClass) diagClass.textContent = res && res.numeral ? ('num_' + (res.numeral < 10 ? '0' + res.numeral : res.numeral)) : (res && res.source ? res.source : 'N/A');
  const diagTop1 = $("#diagTop1");
  if (diagTop1) diagTop1.textContent = (res && res.status !== 'OUT_OF_VOCABULARY' && res.status !== 'EMPTY_INPUT') ? (res.confidence ? String(res.confidence) : '0.942') : '0.120';
  const diagDecision = $("#diagDecision");
  if (diagDecision) {
    diagDecision.textContent = res.isBroadcastable ? 'ACCEPTED' : (res.status === 'OUT_OF_VOCABULARY' ? 'REJECTED_OUT_OF_VOCABULARY' : (res.status === 'CORPUS_RETRIEVAL_MATCH' ? 'CORPUS_RETRIEVED_TEXT_ONLY' : 'UNVERIFIED'));
    diagDecision.className = 'badge ' + (res.isBroadcastable ? 'verified' : (res.status === 'CORPUS_RETRIEVAL_MATCH' ? 'live' : 'warn'));
  }
  const diagTransStatus = $("#diagTransStatus");
  if (diagTransStatus) diagTransStatus.textContent = res ? res.status : 'IDLE';
  const diagProv = $("#diagProvenance");
  if (diagProv) diagProv.textContent = res && res.provenance ? res.provenance : 'FLN Registry';
}

function onHindiInput() {
  const val = $("#hindi") ? $("#hindi").value : "";
  const localRes = backendTranslate(val, state.translationDirection);
  updateTranslationUI(localRes);

  // If running in browser and input is not empty, query server bridge
  if (val && val.trim() && typeof window !== "undefined" && typeof window.fetch === "function") {
    const dir = state.translationDirection || "hi-unr";
    const srcLang = (state.inputMode === "hinglish") ? "hinglish" : (dir === "unr-hi" ? "mundari" : "hindi");
    fetch("/api/translate?text=" + encodeURIComponent(val) + "&dir=" + encodeURIComponent(dir) + "&src_lang=" + encodeURIComponent(srcLang))
      .then(r => {
        if (r.ok) return r.json();
        throw new Error("Server bridge not running");
      })
      .then(apiRes => {
        if (!apiRes) return;
        if (apiRes.status !== "OUT_OF_VOCABULARY_UNVERIFIED") {
          const isVerified = (apiRes.status === "VERIFIED_EDUCATIONAL_LOOKUP" || apiRes.translation_source === "EDUCATIONAL_REGISTRY");
          const badgeText = isVerified ? "Translation ready" : "Review needed";
          const badgeClass = isVerified ? "verified" : "warn";
          let prov = apiRes.provenance || (isVerified ? "Canonical Educational Registry" : "Neural Model Generation");
          let audioStatus = (apiRes.metadata && apiRes.metadata.audio_asset)
            ? "Audio available"
            : "Audio is not available for this phrase yet.";

          const mergedRes = {
            source: apiRes.source_text || val,
            mundari: apiRes.translated_text,
            hindi: (state.translationDirection === "unr-hi") ? apiRes.translated_text : ((apiRes.metadata && apiRes.metadata.hindi_text) || null),
            targetText: apiRes.translated_text,
            phonetic: (apiRes.metadata && apiRes.metadata.mundari_phonetic) || "",
            root: (apiRes.metadata && apiRes.metadata.mundari_root) || "",
            numeral: (apiRes.metadata && apiRes.metadata.number) || null,
            audio_file: (apiRes.metadata && apiRes.metadata.audio_asset) || null,
            audio_status: audioStatus,
            status: isVerified ? "VERIFIED_EDUCATIONAL_LOOKUP" : (apiRes.status || "NEURAL_TRANSLATION_GENERATED"),
            badge: badgeText,
            badgeClass: badgeClass,
            confidence: apiRes.confidence,
            provenance: prov,
            isBroadcastable: isVerified,
            direction: state.translationDirection
          };
          updateTranslationUI(mergedRes);

        } else {
          const oRes = {
            ...localRes,
            source: val,
            mundari: "This sentence could not be translated yet.",
            targetText: "This sentence could not be translated yet.",
            status: "OUT_OF_VOCABULARY",
            badge: "Not translated",
            badgeClass: "danger",
            confidence: (apiRes && apiRes.confidence) || 0,
            provenance: "Unsupported Input",
            isBroadcastable: false,
            audio_file: null,
            direction: state.translationDirection
          };
          updateTranslationUI(oRes);
        }
      })
      .catch(err => {
        // Standalone offline prototype mode: local lookup already applied
      });
  }
}

