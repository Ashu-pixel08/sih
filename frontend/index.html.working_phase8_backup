  display: flex;
  align-items: center;
  gap: 14px;
  text-align: left;
  transition: all 0.16s ease;
  user-select: none;
}
.quiz-option-btn:hover:not(:disabled) {
  border-color: #0f3d2a;
  background: #f0fdf4;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(15, 61, 42, 0.1);
}
.quiz-option-marker {
