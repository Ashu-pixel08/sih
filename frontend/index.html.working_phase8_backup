      case VoiceStateEnum.SPEAKING:
        sessionBtn.innerHTML = "Speaking… Tap to Interrupt";
        sessionBtn.style.background = "#059669";
        sessionBtn.style.boxShadow = "0 6px 20px rgba(5,150,105,0.4)";
        break;
      case VoiceStateEnum.READY:
      case VoiceStateEnum.ERROR:
      default:
        if (voiceState.sessionActive) {
          sessionBtn.innerHTML = "Listening… Tap to Stop";
          sessionBtn.style.background = "#dc2626";
          sessionBtn.style.boxShadow = "0 6px 20px rgba(220,38,38,0.4)";
        } else {
          sessionBtn.innerHTML = "Start Voice Session";
          sessionBtn.style.background = "#ea580c";
          sessionBtn.style.boxShadow = "0 6px 24px rgba(234,88,12,0.4)";
        }
        break;
    }
  }

  if (!statusEl) return;

  if (orbIcon && typeof orbIcon.setAttribute === "function") {
    orbIcon.setAttribute("data-state", newState);
  }

  switch (newState) {
    case VoiceStateEnum.READY:
      statusEl.textContent = "Ready";
      if (subStatusEl) subStatusEl.textContent = (state.inputMode === 'hinglish') ? 'Click "Start Voice Session" or tap the orb to begin speaking' : 'Click "Start Voice Session" or tap the orb to begin speaking in Hindi';
      break;

    case VoiceStateEnum.LISTENING:
      statusEl.textContent = "Listening";
      if (subStatusEl) subStatusEl.textContent = (state.inputMode === 'hinglish') ? "Listening... Speak naturally in Hinglish or Hindi." : "Listening... Speak your sentence naturally in Hindi.";
      break;

    case VoiceStateEnum.PROCESSING:
      statusEl.textContent = "Processing";
      if (subStatusEl) subStatusEl.textContent = "Processing speech input...";
      break;

    case VoiceStateEnum.TRANSLATING:
      statusEl.textContent = "Translating";
      if (subStatusEl) subStatusEl.textContent = "Translating into Mundari...";
      break;

    case VoiceStateEnum.SPEAKING:
      statusEl.textContent = "Speaking";
      if (subStatusEl) subStatusEl.textContent = "Playing pronunciation. Tap orb or speak to interrupt.";
      break;

    case VoiceStateEnum.INTERRUPTED:
      statusEl.textContent = "Interrupted";
      if (subStatusEl) subStatusEl.textContent = "Interrupted — listening again.";
      break;

    case VoiceStateEnum.ERROR:
      statusEl.textContent = "Error";
      if (subStatusEl) subStatusEl.textContent = detailMsg || "Check microphone permissions or use quick classroom phrases.";
      break;
  }
