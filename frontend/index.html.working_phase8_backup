/**
 * Canonical Pronunciation API Client
 * Dispatches to POST /api/pronunciation
 * Handles binary audio/wav Blob, object URL creation/revocation,
 * non-overlapping playback mutex, and teacher-friendly status toasts.
 */
async function playBackendPronunciation(options) {
  const text = (options && options.text) ? String(options.text).trim() : "";
  let language = (options && options.language) ? String(options.language).toLowerCase().trim() : "mundari";
  const onStart = options && typeof options.onStart === "function" ? options.onStart : null;
  const onEnd = options && typeof options.onEnd === "function" ? options.onEnd : null;
  const onError = options && typeof options.onError === "function" ? options.onError : null;
  const useTeacherVoice = (options && typeof options.teacher_voice === "boolean")
    ? options.teacher_voice
    : (state.teacherVoiceEnabled === true);

  // Language normalization: strictly "hindi" or "mundari"
  if (language.includes("hin") || language === "hi" || language === "hi-in") {
    language = "hindi";
  } else if (language.includes("mun") || language.includes("unr")) {
    language = "mundari";
  }

  if (!text) {
    toast("No text to pronounce");
    if (onError) onError(new Error("Empty text"));
    return false;
  }

  // Prevent overlapping playback: stop any currently active audio
  cancelSpeechAudio();

  // Visual pulse indicator if present in current view
  if (typeof playDemoPulse === "function") {
    try { playDemoPulse(); } catch (e) {}
  }

  const isMundari = (language === "mundari");

  try {
    const payload = JSON.stringify({
      text: text,
      language: language,
      teacher_voice: useTeacherVoice
    });
    const response = await fetch("/api/pronunciation", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: payload
    });

    if (!response.ok) {
      const status = response.status;
      if (status === 503) {
        toast("Pronunciation is currently unavailable.");
      } else if (status === 400) {
        toast("Unable to play pronunciation for this input.");
      } else {
        toast("Pronunciation is temporarily unavailable.");
      }

      if (onError) onError(new Error("API returned status " + status));
      return false;
    }

    // Capture response headers for internal diagnostics & testing
    const langHeader = response.headers.get("X-Pronunciation-Language") || language;
    const engineHeader = response.headers.get("X-Pronunciation-Engine") || "";
    const sourceHeader = response.headers.get("X-Pronunciation-Source") || "";
    const valStatusHeader = response.headers.get("X-Pronunciation-Validation-Status") || "";
    const teacherVoiceHeader = response.headers.get("X-Pronunciation-Teacher-Voice") || "INACTIVE";
    const cacheHeader = response.headers.get("X-Pronunciation-Cache") || "";

    state.lastPronunciation = {
      text: text,
      language: langHeader,
      engine: engineHeader,
      source: sourceHeader,
      validationStatus: valStatusHeader,
      teacherVoice: teacherVoiceHeader,
      cache: cacheHeader,
      timestamp: Date.now()
    };

    // Receive audio/wav as a Blob
    const blob = await response.blob();
    let objectUrl = "";
    if (typeof URL !== "undefined" && typeof URL.createObjectURL === "function") {
      objectUrl = URL.createObjectURL(blob);
    } else {
      objectUrl = "/api/pronunciation?text=" + encodeURIComponent(text) + "&language=" + encodeURIComponent(language);
    }

    const audio = new Audio(objectUrl);
    voiceState.activeAudio = audio;
    voiceState.activeAudioUrl = objectUrl;
    voiceState.isSpeaking = true;

    // Toast notification and pill status updates
    const pill = document.getElementById("teacherVoiceStatusPill");
    const dot = document.getElementById("teacherVoiceDot");
    const label = document.getElementById("teacherVoiceLabel");

    // Map to teacher-facing status:
    // 1. "Teacher voice ready" -> teacher profile is active (when idle)
    // 2. "Teacher-adapted audio" -> voice conversion successfully applied (e.g. Hindi teacher-adapted speech)
    // 3. "Synthetic pronunciation — review before classroom use" -> SYNTHETIC_GENERATED_TTS
    // 4. "Prototype audio — pending language validation" -> PROTOTYPE_ONLY_PENDING_HUMAN_VALIDATION
    // 5. "Verified classroom audio" -> ONLY when provenance explicitly indicates HUMAN_VALIDATED or CANONICAL_APPROVED
    let statusLabel = "Teacher voice ready";
    let statusColor = "#10b981";
    let toastMsg = isMundari ? "Playing Mundari pronunciation" : "Playing Hindi pronunciation";

    if (valStatusHeader === "HUMAN_VALIDATED" || valStatusHeader === "CANONICAL_APPROVED") {
      statusLabel = "Verified classroom audio";
      statusColor = "#38bdf8";
      toastMsg = isMundari ? "Playing Mundari (Verified classroom audio)" : "Playing Hindi (Verified classroom audio)";
    } else if (valStatusHeader === "PROTOTYPE_ONLY_PENDING_HUMAN_VALIDATION") {
      statusLabel = "Prototype audio — pending language validation";
      statusColor = "#f59e0b";
      toastMsg = "Playing prototype audio — pending language validation";
    } else if (teacherVoiceHeader === "ACTIVE" || valStatusHeader === "TEACHER_ADAPTED_SYNTHETIC") {
      statusLabel = "Teacher-adapted audio";
      statusColor = "#10b981";
      toastMsg = isMundari ? "Playing Mundari pronunciation (Teacher-adapted audio)" : "Playing Hindi pronunciation (Teacher-adapted audio)";
    } else if (valStatusHeader === "SYNTHETIC_GENERATED_TTS" || teacherVoiceHeader === "BLOCKED_UNCONTROLLED_MUNDARI") {
      statusLabel = "Synthetic pronunciation — review before classroom use";
      statusColor = "#f97316";
      toastMsg = "Synthetic pronunciation — review before classroom use";
    } else if (state.teacherVoiceEnabled && state.teacherVoiceStatus && state.teacherVoiceStatus.status === "READY") {
      statusLabel = "Teacher voice ready";
      statusColor = "#10b981";
    } else {
      statusLabel = "Teacher voice unavailable";
      statusColor = "#9ca3af";
    }

    toast(toastMsg);

    if (label && dot && pill) {
      label.textContent = statusLabel;
      dot.style.background = statusColor;
      pill.style.borderColor = statusColor;
    }

    const cleanup = () => {
      if (voiceState.activeAudio === audio) {
        voiceState.activeAudio = null;
        voiceState.isSpeaking = false;
      }
      if (voiceState.activeAudioUrl === objectUrl) {
        voiceState.activeAudioUrl = null;
      }
      if (objectUrl && typeof URL !== "undefined" && typeof URL.revokeObjectURL === "function") {
        try { URL.revokeObjectURL(objectUrl); } catch (e) {}
      }
      if (typeof updateTeacherVoiceUI === "function") {
        try { updateTeacherVoiceUI(); } catch (e) {}
      }
    };

    audio.onended = () => {
      cleanup();
      if (onEnd) onEnd();
    };

    audio.onerror = (err) => {
      cleanup();
      toast("Unable to play pronunciation audio.");
      if (onError) onError(err);
    };

    if (onStart) onStart();

    await audio.play();
    return true;

  } catch (netErr) {
    cancelSpeechAudio();
    toast("Pronunciation is temporarily unavailable.");
    if (onError) onError(netErr);
    return false;
  }
}
window.playBackendPronunciation = playBackendPronunciation;

function encodeWAV(samples, sampleRate) {
  const buffer = new ArrayBuffer(44 + samples.length * 2);
  const view = new DataView(buffer);

  function writeString(offset, string) {
    for (let i = 0; i < string.length; i++) {
      view.setUint8(offset + i, string.charCodeAt(i));
    }
  }

  writeString(0, 'RIFF');
  view.setUint32(4, 36 + samples.length * 2, true);
  writeString(8, 'WAVE');
  writeString(12, 'fmt ');
  view.setUint32(16, 16, true);
  view.setUint16(20, 1, true); // Linear PCM
  view.setUint16(22, 1, true); // Mono channel
  view.setUint32(24, sampleRate, true);
  view.setUint32(28, sampleRate * 2, true); // Byte rate
  view.setUint16(32, 2, true); // Block align
  view.setUint16(34, 16, true); // 16-bit
  writeString(36, 'data');
  view.setUint32(40, samples.length * 2, true);

  let offset = 44;
  for (let i = 0; i < samples.length; i++, offset += 2) {
    let s = Math.max(-1, Math.min(1, samples[i]));
    view.setInt16(offset, s < 0 ? s * 0x8000 : s * 0x7FFF, true);
  }

  return new Blob([view], { type: 'audio/wav' });
}

function resampleTo16k(audioBuffer, inputSampleRate) {
  if (!audioBuffer || audioBuffer.length === 0) return new Float32Array(0);
  if (inputSampleRate === 16000) return audioBuffer;
  const ratio = inputSampleRate / 16000;
  const newLength = Math.round(audioBuffer.length / ratio);
  const result = new Float32Array(newLength);
  for (let i = 0; i < newLength; i++) {
    const origIndex = i * ratio;
    const indexFloor = Math.floor(origIndex);
    const indexCeil = Math.min(audioBuffer.length - 1, indexFloor + 1);
    const fraction = origIndex - indexFloor;
    result[i] = audioBuffer[indexFloor] * (1 - fraction) + audioBuffer[indexCeil] * fraction;
  }
  return result;
}

async function finishMundariRecordingUtterance(explicitAudioBlob) {
  if (!voiceState.isMundariLocalRecording && !explicitAudioBlob) return;
  voiceState.isMundariLocalRecording = false;

  let wavBlob = explicitAudioBlob || null;

  if (!wavBlob && voiceState.mundariRecorder) {
    const rec = voiceState.mundariRecorder;
    if (rec.silenceTimer) clearTimeout(rec.silenceTimer);

    try {
      if (rec.processor) rec.processor.disconnect();
      if (rec.source) rec.source.disconnect();
      if (rec.stream) rec.stream.getTracks().forEach(t => t.stop());
    } catch (e) {}

    const chunks = rec.recordedChunks || [];
    const inputSampleRate = (rec.audioCtx && rec.audioCtx.sampleRate) || 16000;
    try {
      if (rec.audioCtx && rec.audioCtx.state !== "closed") rec.audioCtx.close();
    } catch (e) {}
    voiceState.mundariRecorder = null;

    let totalLength = 0;
    for (let i = 0; i < chunks.length; i++) totalLength += chunks[i].length;
    if (totalLength === 0) {
      if (voiceState.sessionActive) {
        setTimeout(() => { if (voiceState.sessionActive && !voiceState.isSpeaking) startMundariLocalVoiceSession(); }, 300);
      }
      return;
    }

    const flattened = new Float32Array(totalLength);
    let offset = 0;
    for (let i = 0; i < chunks.length; i++) {
      flattened.set(chunks[i], offset);
      offset += chunks[i].length;
    }

    const resampled = resampleTo16k(flattened, inputSampleRate);
    wavBlob = encodeWAV(resampled, 16000);
  }

  if (!wavBlob) return;

  setVoiceState(VoiceStateEnum.PROCESSING);
  voiceState.isProcessing = true;

  try {
    const resp = await fetch("/api/asr", {
      method: "POST",
      headers: { "Content-Type": "audio/wav" },
      body: wavBlob
    });

    if (resp.ok) {
      const data = await resp.json();
      if (data.status === "RECOGNIZED" && data.recognized_text) {
        const recognized = data.recognized_text;
        const mEl = $("#mundari");
        if (mEl) mEl.value = recognized;
        toast("Recognized Mundari: " + recognized + (data.hindi_equivalent ? " (" + data.hindi_equivalent + ")" : ""));
        await processVoiceUtterance(recognized);
        return;
      } else if (data.status === "BACKGROUND_NOISE") {
        voiceState.isProcessing = false;
        if (voiceState.sessionActive && !voiceState.isSpeaking) {
          startMundariLocalVoiceSession();
        }
        return;
      } else {
        voiceState.isProcessing = false;
        toast("Mundari phrase not recognized in Grade 1 FLN vocabulary (Numbers 1–20). Please speak clearly or use quick phrases.");
        if (voiceState.sessionActive && !voiceState.isSpeaking) {
          setVoiceState(VoiceStateEnum.LISTENING);
          setTimeout(() => {
            if (voiceState.sessionActive && !voiceState.isSpeaking && !voiceState.isMundariLocalRecording) {
              startMundariLocalVoiceSession();
            }
          }, 800);
        } else {
          setVoiceState(VoiceStateEnum.READY);
        }
        return;
      }
    } else {
      voiceState.isProcessing = false;
      toast("Speech recognition service temporarily unavailable.");
      if (voiceState.sessionActive) setVoiceState(VoiceStateEnum.READY);
    }
  } catch (netErr) {
    voiceState.isProcessing = false;
    toast("Speech recognition network error: " + (netErr.message || netErr));
    if (voiceState.sessionActive) setVoiceState(VoiceStateEnum.READY);
  }
}

async function startMundariLocalVoiceSession() {
  cancelSpeechAudio();
  voiceState.sessionActive = true;
  voiceState.restartAttempts = 0;
  voiceState.isMundariLocalRecording = true;

  if (typeof navigator === "undefined" || !navigator.mediaDevices || typeof navigator.mediaDevices.getUserMedia !== "function") {
    setVoiceState(VoiceStateEnum.LISTENING);
    // Architecture Disclosure: Standard browser speech recognition lacks native support for Mundari (unr); handled via local ASR fallback
    toast("Mundari local speech recognition active (offline edge classifier).");
    return true;
  }

  try {
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    if (!AudioCtx) {
      setVoiceState(VoiceStateEnum.ERROR, "Web Audio API not supported in this browser.");
      toast("Web Audio not supported. Please use text input or quick phrases.");
      return false;
    }

    const stream = await navigator.mediaDevices.getUserMedia({
      audio: {
        channelCount: 1,
        echoCancellation: true,
        noiseSuppression: true
      }
    });

    const audioCtx = new AudioCtx();
    const source = audioCtx.createMediaStreamSource(stream);
    const processor = audioCtx.createScriptProcessor(4096, 1, 1);
    const recordedChunks = [];
    let hasSpeech = false;
    let silenceFrames = 0;

    processor.onaudioprocess = (e) => {
      if (!voiceState.sessionActive || !voiceState.isMundariLocalRecording) return;
      const chData = e.inputBuffer.getChannelData(0);
      const copy = new Float32Array(chData.length);
      copy.set(chData);
      recordedChunks.push(copy);

      let sum = 0;
      for (let i = 0; i < copy.length; i++) sum += copy[i] * copy[i];
      const rms = Math.sqrt(sum / copy.length);

      if (rms > 0.02) {
        hasSpeech = true;
        silenceFrames = 0;
        if (voiceState.isSpeaking) {
          cancelSpeechAudio();
          setVoiceState(VoiceStateEnum.INTERRUPTED);
        }
      } else if (hasSpeech) {
        silenceFrames++;
        if (silenceFrames > 12) {
          finishMundariRecordingUtterance();
        }
      }
    };

    source.connect(processor);
    processor.connect(audioCtx.destination);

    voiceState.mundariRecorder = {
      stream,
      audioCtx,
      source,
      processor,
      recordedChunks,
      startTime: Date.now()
    };

    voiceState.mundariRecorder.silenceTimer = setTimeout(() => {
      if (voiceState.sessionActive && voiceState.isMundariLocalRecording) {
        finishMundariRecordingUtterance();
      }
    }, 3500);

    setVoiceState(VoiceStateEnum.LISTENING);
    toast("Listening... Speak Mundari classroom phrase or number (1–20).");
    return true;

  } catch (err) {
    voiceState.sessionActive = false;
    voiceState.isMundariLocalRecording = false;
    const msg = (err && (err.name === "NotAllowedError" || err.name === "PermissionDeniedError"))
      ? "Microphone access denied. Please allow microphone permissions."
      : ("Could not access microphone: " + (err && err.message ? err.message : err));
    setVoiceState(VoiceStateEnum.ERROR, msg);
    toast(msg);
    return false;
  }
}

function startVoiceSession() {
  if (state.translationDirection === "unr-hi" || state.inputMode === "mundari") {
    return startMundariLocalVoiceSession();
  }

  if (!("webkitSpeechRecognition" in window || "SpeechRecognition" in window)) {
    const msg = "Speech recognition unavailable in this browser (WEB PROTOTYPE ONLY — browser speech recognition may require network. Production Android will use the local speech pipeline). Use text input.";
    setVoiceState(VoiceStateEnum.ERROR, msg);
    toast("Browser speech recognition not supported. Please use text input or quick phrases.");
    return false;
  }

  cancelSpeechAudio();
  voiceState.sessionActive = true;
  voiceState.restartAttempts = 0;

  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  let r = new SR();
  r.lang = "hi-IN";
  r.continuous = true;
  r.interimResults = true;
  r.maxAlternatives = 1;
  voiceState.recognition = r;

  r.onstart = () => {
    voiceState.isRecognitionRunning = true;
    voiceState.restartAttempts = 0;
    if (!voiceState.isSpeaking && !voiceState.isProcessing) {
      setVoiceState(VoiceStateEnum.LISTENING);
    }
  };

  r.onspeechstart = () => {
    // BARGE-IN: If audio was speaking, cancel it immediately!
    if (voiceState.isSpeaking) {
      cancelSpeechAudio();
      setVoiceState(VoiceStateEnum.INTERRUPTED);
      clearTimeout(voiceState.interruptedTimeout);
      voiceState.interruptedTimeout = setTimeout(() => {
        if (voiceState.sessionActive && !voiceState.isSpeaking) {
          setVoiceState(VoiceStateEnum.PROCESSING);
        }
      }, 450);
    } else if (!voiceState.isProcessing) {
      setVoiceState(VoiceStateEnum.PROCESSING);
    }
  };

  r.onsoundstart = () => {
    if (voiceState.isSpeaking) {
      cancelSpeechAudio();
      setVoiceState(VoiceStateEnum.INTERRUPTED);
    }
  };

  r.onresult = (e) => {
    // BARGE-IN check on any speech result while speaking
    if (voiceState.isSpeaking) {
      cancelSpeechAudio();
      setVoiceState(VoiceStateEnum.INTERRUPTED);
    }

    let interim = "";
    let finalTranscript = "";

    for (let i = e.resultIndex; i < e.results.length; ++i) {
      const trans = e.results[i][0].transcript;
      if (e.results[i].isFinal) {
        finalTranscript += trans;
      } else {
        interim += trans;
      }
    }

    if (interim.trim()) {
      const hEl = $("#hindi");
      if (hEl) hEl.value = interim;
      if (!voiceState.isSpeaking) {
        setVoiceState(VoiceStateEnum.PROCESSING);
      }
    }

    if (finalTranscript.trim()) {
      const captured = finalTranscript.trim();
      const hEl = $("#hindi");
      if (hEl) hEl.value = captured;
      processVoiceUtterance(captured);
    }
  };

  r.onerror = (e) => {
    const errCode = e.error || "unknown";
    if (errCode === "no-speech") {
      // Normal pause in natural speech; continue listening
      if (voiceState.sessionActive && !voiceState.isSpeaking && !voiceState.isProcessing) {
        setVoiceState(VoiceStateEnum.LISTENING);
      }
      return;
    }

    if (errCode === "not-allowed" || errCode === "permission-denied") {
      stopVoiceSession();
      const msg = "Microphone access was denied. Please allow microphone permissions or type text.";
      setVoiceState(VoiceStateEnum.ERROR, msg);
      toast(msg);
      return;
    }

    if (errCode === "network") {
      const msg = "WEB PROTOTYPE ONLY — browser speech recognition may require network. Production Android will use the local speech pipeline. Please use text input.";
      setVoiceState(VoiceStateEnum.ERROR, msg);
      toast(msg);
      // Gentle restart if session still active
      if (voiceState.sessionActive) {
        clearTimeout(voiceState.restartTimeout);
        voiceState.restartTimeout = setTimeout(() => {
          if (voiceState.sessionActive && !voiceState.isRecognitionRunning) {
            try { r.start(); } catch(err) {}
          }
        }, 1500);
      }
      return;
    }

    if (errCode === "aborted") {
      return; // Explicit stop or restart
    }

    // Other recoverable error
    if (voiceState.sessionActive) {
      clearTimeout(voiceState.restartTimeout);
      voiceState.restartTimeout = setTimeout(() => {
        if (voiceState.sessionActive && !voiceState.isRecognitionRunning) {
          try { r.start(); } catch(err) {}
        }
      }, 500);
    }
  };

  r.onend = () => {
    voiceState.isRecognitionRunning = false;
    // Browser speech recognition ended (silence or timeout); automatically restart if session active!
    if (voiceState.sessionActive) {
      clearTimeout(voiceState.restartTimeout);
      voiceState.restartTimeout = setTimeout(() => {
        if (voiceState.sessionActive && !voiceState.isRecognitionRunning) {
          try {
            r.start();
          } catch (err) {
            // Already started or busy; ignore
          }
        }
      }, 100);
    }
  };

  try {
    r.start();
    setVoiceState(VoiceStateEnum.LISTENING);
    toast("Continuous Voice Session started. Speak Hindi anytime.");
    return true;
  } catch (err) {
    voiceState.sessionActive = false;
    setVoiceState(VoiceStateEnum.ERROR, "Could not start microphone: " + err.message);
    toast("Microphone initialization error: " + err.message);
    return false;
  }
}

function stopVoiceSession() {
  voiceState.sessionActive = false;
  clearTimeout(voiceState.restartTimeout);
  clearTimeout(voiceState.interruptedTimeout);
  cancelSpeechAudio();

  if (voiceState.mundariRecorder) {
    try {
      if (voiceState.mundariRecorder.silenceTimer) clearTimeout(voiceState.mundariRecorder.silenceTimer);
      if (voiceState.mundariRecorder.processor) voiceState.mundariRecorder.processor.disconnect();
      if (voiceState.mundariRecorder.source) voiceState.mundariRecorder.source.disconnect();
      if (voiceState.mundariRecorder.stream) {
        voiceState.mundariRecorder.stream.getTracks().forEach(t => t.stop());
      }
      if (voiceState.mundariRecorder.audioCtx && voiceState.mundariRecorder.audioCtx.state !== "closed") {
        voiceState.mundariRecorder.audioCtx.close();
      }
    } catch (e) {}
    voiceState.mundariRecorder = null;
  }
  voiceState.isMundariLocalRecording = false;

  if (voiceState.recognition) {
    try {
      voiceState.recognition.stop();
    } catch (err) {}
    voiceState.recognition = null;
  }
  voiceState.isRecognitionRunning = false;
  voiceState.isProcessing = false;
  voiceState.isSpeaking = false;

  setVoiceState(VoiceStateEnum.READY);
  toast("Voice session stopped.");
}

function toggleVoiceSession() {
  if (voiceState.sessionActive) {
    if (voiceState.isMundariLocalRecording && voiceState.mundariRecorder && voiceState.mundariRecorder.recordedChunks && voiceState.mundariRecorder.recordedChunks.length > 0) {
      finishMundariRecordingUtterance();
      return;
    }
    stopVoiceSession();
  } else {
    startVoiceSession();
  }
}

