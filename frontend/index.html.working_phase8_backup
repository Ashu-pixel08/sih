function updateWsSetting(key, val) {
  state.worksheetSettings[key] = val;
  renderWorksheetPreview();
}

function renderWorksheetPreview() {
  const area = $("#wsPreviewArea");
  if (!area) return;

  const cfg = state.worksheetSettings;
  const count = cfg.count || 10;
  const grade = cfg.grade || "1";
  const school = cfg.school || "Primary School, Khunti, Jharkhand";
  const qType = cfg.questionType || "mixed";
  const incImages = cfg.includeImages;

  // Filter pool
  let pool = (state.educationalVocab && state.educationalVocab.length > 0)
    ? state.educationalVocab.filter(x => x.is_verified)
    : [];
  if (pool.length === 0 && state.educationalVocab) {
    pool = state.educationalVocab;
  }
  if (cfg.category && cfg.category !== "all") {
    const catF = pool.filter(x => x.category.toLowerCase() === cfg.category.toLowerCase());
    if (catF.length >= 3) pool = catF;
  }

  const shuffled = [...pool].sort(() => Math.random() - 0.5);
  const selected = shuffled.slice(0, Math.min(count, shuffled.length));

  let questionsHtml = "";
  let answerKeyList = [];

  if (qType === "type_1") {
    // 1. Image Identification
    questionsHtml = `
      <div style="margin:16px 0">
        <h4>प्रश्न 1. चित्र देखकर नाम लिखें (Look at the pictures and write Hindi and Mundari names):</h4>
        <div class="grid g3 mt">
          ${selected.map((it, idx) => {
            answerKeyList.push(`Q${idx+1}: Hindi: ${it.hindi} | Mundari: ${it.mundari} (${it.english})`);
            return `
              <div class="card" style="text-align:center;padding:12px;border:1px dashed #627368">
                ${incImages && it.image_url ? `
                  <img src="${it.image_url}" alt="${esc(it.english)}" style="height:90px;max-width:100%;object-fit:contain;margin-bottom:6px" />
                ` : '<div style="height:70px;background:#f0f0f0;display:flex;align-items:center;justify-content:center;font-weight:700">[ चित्र ]</div>'}
                <div style="font-size:12px;color:var(--muted);margin:4px 0">${esc(it.english)}</div>
                <div style="margin-top:8px;font-size:13px">हिंदी: __________________</div>
                <div style="margin-top:6px;font-size:13px">मुंडारी: __________________</div>
              </div>
            `;
          }).join("")}
        </div>
      </div>
    `;
  } else if (qType === "type_2") {
    // 2. Match Image with Word
    const rightList = [...selected].sort(() => Math.random() - 0.5);
    questionsHtml = `
      <div style="margin:16px 0">
        <h4>प्रश्न 2. चित्र को सही शब्द से मिलाओ (Match each picture with its word):</h4>
        <table class="table mt" style="border:1px solid var(--line)">
          <tr><th style="width:45%">चित्र (Images)</th><th style="width:10%">उत्तर</th><th style="width:45%">शब्द (Words)</th></tr>
          ${selected.map((it, idx) => {
            const rightItem = rightList[idx];
            answerKeyList.push(`Item (${String.fromCharCode(65+idx)}) [${it.english}] matches [ ${rightList.findIndex(x => x.id === it.id) + 1} ]`);
            return `
              <tr>
                <td style="vertical-align:middle">
                  <b>(${String.fromCharCode(65+idx)})</b>
                  ${incImages && it.image_url ? `
                    <img src="${it.image_url}" alt="${esc(it.english)}" style="height:55px;width:70px;object-fit:contain;vertical-align:middle;margin-left:8px"/>
                  ` : ` [ चित्र: ${esc(it.english)} ]`}
                </td>
                <td style="text-align:center;vertical-align:middle">
                  [ &nbsp;&nbsp;&nbsp;&nbsp; ]
                </td>
                <td style="vertical-align:middle">
                  <b>${idx+1}.</b> ${esc(rightItem.hindi)} • <span style="font-weight:700;color:var(--green)">${esc(rightItem.mundari)}</span> (${esc(rightItem.english)})
                </td>
              </tr>
            `;
          }).join("")}
        </table>
      </div>
    `;
  } else if (qType === "type_3") {
    // 3. Hindi -> Mundari
    questionsHtml = `
      <div style="margin:16px 0">
        <h4>प्रश्न 3. दिए गए हिंदी शब्दों का मुंडारी रूप लिखें (Write the Mundari translation):</h4>
        <div class="grid g2 mt">
          ${selected.map((it, idx) => {
            answerKeyList.push(`Q${idx+1}: ${it.hindi} ➔ ${it.mundari}`);
            return `
              <div style="padding:10px;border-bottom:1px solid var(--line);font-size:14px">
                <b>${idx+1}.</b> ${esc(it.hindi)} (${esc(it.english)}) ➔ मुंडारी: ________________________
              </div>
            `;
          }).join("")}
        </div>
      </div>
    `;
  } else if (qType === "type_4") {
    // 4. Mundari -> Hindi
    questionsHtml = `
      <div style="margin:16px 0">
        <h4>प्रश्न 4. दिए गए मुंडारी शब्दों का हिंदी अर्थ लिखें (Write the Hindi meaning of Mundari words):</h4>
        <div class="grid g2 mt">
          ${selected.map((it, idx) => {
            answerKeyList.push(`Q${idx+1}: ${it.mundari} ➔ ${it.hindi}`);
            return `
              <div style="padding:10px;border-bottom:1px solid var(--line);font-size:14px">
                <b>${idx+1}.</b> <span style="color:var(--green);font-weight:800">${esc(it.mundari)}</span> (${esc(it.english)}) ➔ हिंदी: ________________________
              </div>
            `;
          }).join("")}
        </div>
      </div>
    `;
  } else if (qType === "type_5") {
    // 5. Fill in the blank
    questionsHtml = `
      <div style="margin:16px 0">
        <h4>प्रश्न 5. रिक्त स्थान भरें (Fill in the blanks with the correct Mundari or Hindi word):</h4>
        <div style="margin-top:10px">
          ${selected.map((it, idx) => {
            answerKeyList.push(`Q${idx+1}: ${it.mundari}`);
            return `
              <div style="padding:10px;border-bottom:1px solid var(--line);font-size:14px;line-height:1.6">
                <b>${idx+1}.</b> ${esc(it.hindi)} (${esc(it.english)}) को मुंडारी भाषा में <b>__________________</b> कहा जाता है।
              </div>
            `;
          }).join("")}
        </div>
      </div>
    `;
  } else if (qType === "type_6") {
    // 6. Multiple Choice Questions
    questionsHtml = `
      <div style="margin:16px 0">
        <h4>प्रश्न 6. सही विकल्प पर गोला लगाओ (Choose the correct option):</h4>
        <div class="grid g2 mt">
          ${selected.map((it, idx) => {
            const others = pool.filter(x => x.id !== it.id).sort(() => Math.random() - 0.5).slice(0, 3);
            const opts = [it, ...others].sort(() => Math.random() - 0.5);
            const correctLetter = String.fromCharCode(65 + opts.findIndex(x => x.id === it.id));
            answerKeyList.push(`Q${idx+1}: (${correctLetter}) ${it.mundari}`);
            return `
              <div class="card" style="padding:12px;border:1px solid var(--line)">
                <div style="font-weight:700;font-size:13.5px;margin-bottom:8px">
                  ${idx+1}. '${esc(it.hindi)}' (${esc(it.english)}) का मुंडारी शब्द क्या है?
                </div>
                <div class="grid g2" style="font-size:12.5px;gap:6px">
                  ${opts.map((opt, oIdx) => `
                    <div>(${String.fromCharCode(65+oIdx)}) ○ ${esc(opt.mundari)}</div>
                  `).join("")}
                </div>
              </div>
            `;
          }).join("")}
        </div>
      </div>
    `;
  } else if (qType === "type_7") {
    // 7. Two Column Matching
    const rightCol = [...selected].sort(() => Math.random() - 0.5);
    questionsHtml = `
      <div style="margin:16px 0">
        <h4>प्रश्न 7. कॉलम 'क' को कॉलम 'ख' से सुमेलित करें (Match Column A with Column B):</h4>
        <table class="table mt" style="border:1px solid var(--line)">
          <tr><th style="width:45%">कॉलम 'क' (हिंदी शब्द)</th><th style="width:10%;text-align:center">उत्तर</th><th style="width:45%">कॉलम 'ख' (मुंडारी शब्द)</th></tr>
          ${selected.map((it, idx) => {
            const rightItem = rightCol[idx];
            const matchIndex = rightCol.findIndex(x => x.id === it.id);
            answerKeyList.push(`${idx+1} ➔ (${String.fromCharCode(65+matchIndex)}) [${it.hindi} - ${it.mundari}]`);
            return `
              <tr>
                <td><b>${idx+1}.</b> ${esc(it.hindi)} (${esc(it.english)})</td>
                <td style="text-align:center">[ &nbsp;&nbsp;&nbsp;&nbsp; ]</td>
                <td><b>(${String.fromCharCode(65+idx)})</b> <span style="color:var(--green);font-weight:700">${esc(rightItem.mundari)}</span></td>
              </tr>
            `;
          }).join("")}
        </table>
      </div>
    `;
  } else if (qType === "type_8") {
    // 8. Counting & Numeracy
    const numSubset = DB.numbers.slice(0, Math.min(count, DB.numbers.length));
    questionsHtml = `
      <div style="margin:16px 0">
        <h4>प्रश्न 8. गिनो और लिखो (Count the dots and write Hindi & Mundari numbers):</h4>
        <div class="grid g2 mt">
          ${numSubset.map((it, idx) => {
            answerKeyList.push(`Item ${idx+1}: Number ${it.number} (${it.hindi_text} / ${it.mundari_text})`);
            return `
              <div class="card" style="text-align:center;padding:12px;border:1px dashed #4F8A5B">
                ${renderTenFrame(it.number <= 10 ? it.number : 10)}
                <div style="margin-top:10px;font-size:13px">
