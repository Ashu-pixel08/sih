<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App Identity Header -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center" />

        <!-- Offline Badge -->
        <TextView
            android:id="@+id/tvOfflineBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:background="#0284C7"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/offline_demo_badge" />

        <!-- FLN Pedagogy Scope -->
        <TextView
            android:id="@+id/tvPedagogyScope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nipun_fln_scope"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

        <!-- Record / Capture Action -->
        <Button
            android:id="@+id/btnRecord"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="🎤 Tap to Speak Hindi Number (1–20)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            android:textColor="#FFFFFF" />

        <!-- Status Message -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_ready"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

        <!-- Result Card -->
        <LinearLayout
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/card_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRecognizedHindi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="—"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confidence: —"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Mundari Vernacular Translation -->
            <TextView
                android:id="@+id/tvMundariLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mundari Translation (मुंडारी):"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvMundariText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tvMundariPhonetic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phonetic: —"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <!-- Badges Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProvenance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#E2E8F0"
                    android:textColor="#334155"
                    android:textSize="10sp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="CORPUS_ATTESTED" />

                <TextView
                    android:id="@+id/tvBroadcastStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#DCFCE7"
                    android:textColor="#15803D"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="@string/broadcast_allowed" />
            </LinearLayout>

            <!-- Audio Playback Button -->
            <Button
                android:id="@+id/btnPlayAudio"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="🔊 Play Pronunciation (Synthetic Prototype)"
                android:textSize="13sp"
                android:backgroundTint="#475569"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvAudioNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/audio_status_badge"
                android:textSize="10sp"
                android:textColor="#94A3B8"
                android:gravity="center" />

            <!-- Low-Confidence Warning / Retry Notice -->
            <LinearLayout
                android:id="@+id/layoutLowConfidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FEF3C7"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvLowConfidencePrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/prompt_please_repeat"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#B45309" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Audio confidence was below threshold. Try speaking closer to microphone, or tap a number card below (Pathway C)."
                    android:textSize="11sp"
                    android:textColor="#92400E" />
            </LinearLayout>
        </LinearLayout>

        <!-- Direct Selection / Fallback Grid Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pathway_c_title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guaranteed offline fallback when classroom noise is high:"
            android:textSize="11sp"
            android:textColor="#64748B" />

        <!-- Fallback Number Buttons (Grid or Flow) -->
        <GridLayout
            android:id="@+id/gridDirectSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="5"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true" />

        <!-- Developer Diagnostics Section (Non-cluttering toggle) -->
        <LinearLayout
            android:id="@+id/cardDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:background="#F8FAFC"
            android:orientation="vertical"
            android:padding="12dp">

            <Button
                android:id="@+id/btnToggleDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:backgroundTint="#475569"
                android:text="🛠️ Developer Diagnostics [Toggle]"
                android:textSize="12sp"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:id="@+id/layoutDiagnosticsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvDiagAudioStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Audio: Duration — | RMS: —"
                    android:textSize="11sp"
                    android:textColor="#334155" />

                <TextView
                    android:id="@+id/tvDiagClassAndConf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Classifier: Class: — | Conf: — | 2nd: — | Margin: —"
                    android:textSize="11sp"
                    android:textColor="#334155" />

                <TextView
                    android:id="@+id/tvDiagDecision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Decision: — | Translation: —"
                    android:textSize="11sp"
                    android:textColor="#334155" />

                <TextView
                    android:id="@+id/tvDiagProvenance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Audio Provenance: —"
                    android:textSize="11sp"
                    android:textColor="#334155" />

                <TextView
                    android:id="@+id/tvDiagTimestamps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Timestamps (T0-T4): —"
                    android:textSize="11sp"
                    android:textColor="#334155" />

                <TextView
                    android:id="@+id/tvDiagHardwareNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Hardware Latency: PENDING_PHYSICAL_DEVICE_DEPLOYMENT"
                    android:textSize="10sp"
                    android:textColor="#64748B"
                    android:textStyle="italic" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
